+        )
+        for _ in range(400)
+    ]
+    key = _py_cmp_sort_key(lambda x, y: -1 if Package._py_lt(x, y) else (1 if Package._py_lt(y, x) else 0))
+    assert [id(p) for p in sorted(pkgs)] == [id(p) for p in sorted(pkgs, key=key)]
+    assert min(pkgs) is min(pkgs, key=key)
+    assert max(pkgs) is max(pkgs, key=key)
