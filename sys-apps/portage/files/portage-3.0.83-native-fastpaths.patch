+def make_package(cp="dev-libs/foo", version="1.0", built=False, build_time=None):
+    """An instance of the real class with only the slots the ordering reads."""
+    from _emerge.Package import Package
+
+    pkg = object.__new__(Package)
+    pkg.cp = cp
+    pkg.version = version
+    pkg.built = built
+    if build_time is not None:
+        pkg.cpv = FakeCpv(build_time)
+    pkg._hash_key = ("fake", cp, version, built, build_time)
+    pkg._hash_value = hash(pkg._hash_key)
+    return pkg
+
+
+def package_cases():
+    pkgs = [
+        make_package(),
+        make_package(),
+        make_package(version="1.0-r1"),
+        make_package(version="2.0"),
+        make_package(version="1.0_rc1"),
+        make_package(cp="dev-libs/bar"),
+        make_package(cp="sys-apps/foo", version="0.1"),
+        make_package(built=True, build_time=100),
+        make_package(built=True, build_time=100),
+        make_package(built=True, build_time=200),
+        make_package(built=True),  # built without cpv: build_time raises
+        make_package(version="2.0", built=True, build_time=50),
+        make_package(version="not a version"),  # vercmp() returns None
+        make_package(cp=None),
+        make_package(cp=5),
+        make_package(built=1, build_time=7),
+        make_package(cp="x/y"),
+    ]
+    for slot in ("cp", "version", "built"):
+        pkgs.append(_missing(slot))  # the slot is unset: AttributeError
+    return pkgs
