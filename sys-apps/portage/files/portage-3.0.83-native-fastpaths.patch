+		for (i = 0; i < 6; i++) {
+			flag = SLOT_AT(self, prio_off[i]);
+			if (flag == NULL)
+				goto python;	/* unset slot: AttributeError there */
+			if (flag == Py_True)
+				return PyLong_FromLong(prio_value[i]);
+			if (flag == Py_False || flag == Py_None)
+				continue;
+			Py_INCREF(flag);
+			truth = PyObject_IsTrue(flag);
+			Py_DECREF(flag);
+			if (truth < 0)
+				return NULL;
+			if (truth)
+				return PyLong_FromLong(prio_value[i]);
+		}
+		return PyLong_FromLong(-6);
+	}
+python:
+	return PyObject_CallMethodNoArgs(self, str_dunder_int);
+}
