@@ -0,0 +1,427 @@
+/* Copyright 2026 Gentoo Authors
+ * Distributed under the terms of the GNU General Public License v2
+ *
+ * Two hot paths of the dependency resolver that are plain data work:
+ *
+ *   SlotDictBase   base of portage.cache.mappings._SlotDict: __getitem__ and
+ *                  get() without a Python frame, plus a "hooked" __getitem__
+ *                  for _emerge.Package._PackageMetadataWrapper (about a
+ *                  million metadata lookups per dependency calculation).
+ *   convert()      turns the tree returned by portage.dep._parser.parse()
+ *                  into lists of portage.dep.Atom, taking remembered atoms
+ *                  straight from the memo dict (_c_convert_result and
+ *                  _c_flatten_result of portage/dep/__init__.py).
+ *
+ * Whatever is not the common case is handed to the Python code that these
+ * replace, which stays in place as the fallback for builds without native
+ * extensions and as the reference of
+ * lib/portage/tests/util/test_cfast.py.
+ */
+
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+
+static PyObject *str_c_keymap = NULL;		/* "_c_keymap" */
+static PyObject *str_c_slow_keys = NULL;	/* "_c_slow_keys" */
+static PyObject *str_py_raw_getitem = NULL;	/* "_py_raw_getitem" */
+static PyObject *str_py_getitem = NULL;		/* "_py_getitem" */
+static PyObject *str_use = NULL;		/* "_use" */
+static PyObject *str_conditional = NULL;	/* "conditional" */
+static PyObject *keymap_builder = NULL;		/* set by set_keymap_builder() */
+
+/* ------------------------------------------------------------------ */
+/* SlotDictBase                                                         */
+
+/* The class's {key: slot descriptor} dict, a new reference. It lives in the
+ * class's own __dict__ as _c_keymap; the Python builder makes it on first
+ * use (portage.cache.mappings._build_c_keymap). */
+static PyObject *
+slotdict_keymap(PyTypeObject *tp)
+{
+	PyObject *dict, *map;
+
+	dict = PyType_GetDict(tp);
+	if (dict == NULL)
+		return NULL;
+	map = PyDict_GetItemWithError(dict, str_c_keymap);
+	Py_XINCREF(map);
+	Py_DECREF(dict);
+	if (map != NULL)
+		return map;
+	if (PyErr_Occurred())
+		return NULL;
+	if (keymap_builder == NULL) {
+		PyErr_SetString(PyExc_RuntimeError,
+			"portage.util._cfast: no keymap builder registered");
+		return NULL;
+	}
+	map = PyObject_CallOneArg(keymap_builder, (PyObject *)tp);
+	if (map != NULL && !PyDict_Check(map)) {
+		Py_DECREF(map);
+		PyErr_SetString(PyExc_TypeError, "keymap builder must return a dict");
+		return NULL;
+	}
+	return map;
+}
+
+/*  def __getitem__(self, k):
+ *      try:
+ *          return getattr(self, self._prefix + k)
+ *      except AttributeError:
+ *          raise KeyError(k)
+ *
+ * Fast path: k is exactly a str and names an ordinary slot of the class.
+ * Everything else is answered by the Python body (_py_raw_getitem).
+ * With quiet set, an unset slot returns NULL with *missing = 1 and no
+ * exception. */
+static PyObject *
+slotdict_lookup(PyObject *self, PyObject *k, int quiet, int *missing)
+{
+	PyObject *map, *descr, *value;
+	descrgetfunc get;
+
+	if (PyUnicode_CheckExact(k)) {
+		map = slotdict_keymap(Py_TYPE(self));
+		if (map == NULL)
+			return NULL;
+		descr = PyDict_GetItemWithError(map, k);
+		Py_XINCREF(descr);
+		Py_DECREF(map);
+		if (descr != NULL) {
+			get = Py_TYPE(descr)->tp_descr_get;
+			if (get == NULL) {
+				Py_DECREF(descr);
+				PyErr_SetString(PyExc_TypeError,
+					"_c_keymap value is not a descriptor");
+				return NULL;
+			}
+			value = get(descr, self, (PyObject *)Py_TYPE(self));
+			Py_DECREF(descr);
+			if (value == NULL && PyErr_ExceptionMatches(PyExc_AttributeError)) {
+				PyErr_Clear();
+				if (quiet)
+					*missing = 1;
+				else
+					PyErr_SetObject(PyExc_KeyError, k);
+			}
+			return value;
+		}
+		if (PyErr_Occurred())
+			return NULL;
+	}
+	return PyObject_CallMethodOneArg(self, str_py_raw_getitem, k);
+}
+
+static PyObject *
+slotdict_subscript(PyObject *self, PyObject *k)
+{
+	return slotdict_lookup(self, k, 0, NULL);
+}
+
+/* The __getitem__ of a subclass that treats some keys specially: a key in
+ * the class's _c_slow_keys goes to the subclass's Python method
+ * _py_getitem, any other key is a plain lookup. */
+static PyObject *
+slotdict_getitem_hooked(PyObject *self, PyObject *k)
+{
+	PyObject *slow;
+	int is_slow;
+
+	slow = PyObject_GetAttr((PyObject *)Py_TYPE(self), str_c_slow_keys);
+	if (slow == NULL)
+		return NULL;
+	is_slow = PySequence_Contains(slow, k);
+	Py_DECREF(slow);
+	if (is_slow < 0)
+		return NULL;
+	if (is_slow)
+		return PyObject_CallMethodOneArg(self, str_py_getitem, k);
+	return slotdict_lookup(self, k, 0, NULL);
+}
+
+/*  def get(self, key, default=None):
+ *      try:
+ *          return self[key]
+ *      except KeyError:
+ *          return default
+ */
+static PyObject *
+slotdict_get(PyObject *self, PyObject *const *args, Py_ssize_t nargs)
+{
+	PyObject *key, *fallback = Py_None, *value;
+	PyMappingMethods *mapping = Py_TYPE(self)->tp_as_mapping;
+	int missing = 0;
+
+	if (nargs < 1 || nargs > 2) {
+		PyErr_Format(PyExc_TypeError,
+			"get expected 1 or 2 arguments, got %zd", nargs);
+		return NULL;
+	}
+	key = args[0];
+	if (nargs == 2)
+		fallback = args[1];
+
+	if (mapping != NULL && mapping->mp_subscript == slotdict_subscript)
+		value = slotdict_lookup(self, key, 1, &missing);
+	else
+		value = PyObject_GetItem(self, key);	/* an overriding __getitem__ */
+	if (value != NULL)
+		return value;
+	if (!missing) {
+		if (!PyErr_ExceptionMatches(PyExc_KeyError))
+			return NULL;
+		PyErr_Clear();
+	}
+	return Py_NewRef(fallback);
+}
+
+static PyMethodDef slotdict_methods[] = {
+	{"get", (PyCFunction)(void (*)(void))slotdict_get, METH_FASTCALL,
+	 "get(key, default=None): self[key], or default if the key is unset"},
+	{"_c_getitem_hooked", slotdict_getitem_hooked, METH_O,
+	 "__getitem__ for a subclass with _c_slow_keys and _py_getitem"},
+	{NULL}
+};
+
+static PyType_Slot slotdict_slots[] = {
+	{Py_mp_subscript, slotdict_subscript},
+	{Py_tp_methods, slotdict_methods},
+	{0, NULL}
+};
+
+static PyType_Spec slotdict_spec = {
+	.name = "portage.util._cfast.SlotDictBase",
+	.basicsize = sizeof(PyObject),
+	.flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE,
+	.slots = slotdict_slots,
+};
+
+static PyObject *
+cfast_set_keymap_builder(PyObject *Py_UNUSED(module), PyObject *func)
+{
+	if (!PyCallable_Check(func)) {
+		PyErr_SetString(PyExc_TypeError, "expected a callable");
+		return NULL;
+	}
+	Py_XSETREF(keymap_builder, Py_NewRef(func));
+	Py_RETURN_NONE;
+}
+
+/* ------------------------------------------------------------------ */
+/* convert()                                                            */
+
+typedef struct {
+	PyObject *memo;		/* {(token string, eapi): Atom} */
+	PyObject *slow;		/* _c_atom_from_c */
+	PyObject *eapi;
+	PyObject *eapi_attrs;
+	PyObject *uselist;
+	PyObject *matchall;
+	int matchall_true;
+} convert_ctx;
+
+/* _c_atom_from_c(catom, eapi, eapi_attrs, uselist, matchall) for a token
+ * whose Atom is remembered and needs no USE evaluation; the Python function
+ * for every other token. Returns a new reference. */
+static PyObject *
+convert_atom(PyObject *catom, convert_ctx *ctx)
+{
+	PyObject *token, *key, *atom, *use, *conditional;
+	int truth;
+
+	token = PyObject_Str(catom);
+	if (token == NULL)
+		return NULL;
+	key = PyTuple_Pack(2, token, ctx->eapi);
+	Py_DECREF(token);
+	if (key == NULL)
+		return NULL;
+	atom = PyDict_GetItemWithError(ctx->memo, key);
+	Py_XINCREF(atom);
+	Py_DECREF(key);
+	if (atom == NULL && PyErr_Occurred())
+		return NULL;
+
+	if (atom != NULL && atom != Py_None) {
+		if (ctx->matchall_true)
+			return atom;
+		use = PyObject_GetAttr(atom, str_use);
+		if (use == NULL) {
+			Py_DECREF(atom);
+			return NULL;
+		}
+		if (use == Py_None) {
+			Py_DECREF(use);
+			return atom;
+		}
+		conditional = PyObject_GetAttr(use, str_conditional);
+		Py_DECREF(use);
+		if (conditional == NULL) {
+			Py_DECREF(atom);
+			return NULL;
+		}
+		truth = PyObject_IsTrue(conditional);
+		Py_DECREF(conditional);
+		if (truth < 0) {
+			Py_DECREF(atom);
+			return NULL;
+		}
+		if (!truth)
+			return atom;
+	}
+	Py_XDECREF(atom);
+	return PyObject_CallFunctionObjArgs(ctx->slow, catom, ctx->eapi,
+		ctx->eapi_attrs, ctx->uselist, ctx->matchall, NULL);
+}
+
+/* Append the conversion of items to out: nested lists stay nested
+ * (_c_convert_result) or are spliced in (flat, _c_flatten_result). */
+static int
+convert_into(PyObject *items, PyObject *out, int flat, convert_ctx *ctx)
+{
+	Py_ssize_t i;
+	PyObject *item, *converted;
+	int rc;
+
+	if (Py_EnterRecursiveCall(" while converting a dependency string"))
+		return -1;
+	/* the list can change while Python code runs: re-read its size */
+	for (i = 0; i < PyList_GET_SIZE(items); i++) {
+		item = Py_NewRef(PyList_GET_ITEM(items, i));
+		if (PyUnicode_Check(item)) {
+			rc = PyList_Append(out, item);
+		}
+		else if (PyList_Check(item)) {
+			if (flat) {
+				rc = convert_into(item, out, 1, ctx);
+			}
+			else {
+				converted = PyList_New(0);
+				rc = -1;
+				if (converted != NULL) {
+					rc = convert_into(item, converted, 0, ctx);
+					if (rc == 0)
+						rc = PyList_Append(out, converted);
+					Py_DECREF(converted);
+				}
+			}
+		}
+		else {
+			converted = convert_atom(item, ctx);
+			rc = -1;
+			if (converted != NULL) {
+				rc = PyList_Append(out, converted);
+				Py_DECREF(converted);
+			}
+		}
+		Py_DECREF(item);
+		if (rc < 0) {
+			Py_LeaveRecursiveCall();
+			return -1;
+		}
+	}
+	Py_LeaveRecursiveCall();
+	return 0;
+}
+
+static PyObject *
+cfast_convert(PyObject *Py_UNUSED(module), PyObject *const *args, Py_ssize_t nargs)
+{
+	convert_ctx ctx;
+	PyObject *raw, *out;
+	int flat;
+
+	if (nargs != 8) {
+		PyErr_Format(PyExc_TypeError,
+			"convert expected 8 arguments, got %zd", nargs);
+		return NULL;
+	}
+	raw = args[0];
+	if (!PyList_Check(raw)) {
+		PyErr_SetString(PyExc_TypeError, "convert: the parse tree must be a list");
+		return NULL;
+	}
+	flat = PyObject_IsTrue(args[1]);
+	if (flat < 0)
+		return NULL;
+	ctx.memo = args[2];
+	if (!PyDict_Check(ctx.memo)) {
+		PyErr_SetString(PyExc_TypeError, "convert: the memo must be a dict");
+		return NULL;
+	}
+	ctx.slow = args[3];
+	ctx.eapi = args[4];
+	ctx.eapi_attrs = args[5];
+	ctx.uselist = args[6];
+	ctx.matchall = args[7];
+	ctx.matchall_true = PyObject_IsTrue(ctx.matchall);
+	if (ctx.matchall_true < 0)
+		return NULL;
+
+	out = PyList_New(0);
+	if (out == NULL)
+		return NULL;
+	if (convert_into(raw, out, flat, &ctx) < 0) {
+		Py_DECREF(out);
+		return NULL;
+	}
+	return out;
+}
+
+/* ------------------------------------------------------------------ */
+/* module                                                               */
+
+static PyMethodDef cfast_functions[] = {
+	{"set_keymap_builder", cfast_set_keymap_builder, METH_O,
+	 "set_keymap_builder(func): func(cls) makes and returns cls._c_keymap"},
+	{"convert", (PyCFunction)(void (*)(void))cfast_convert, METH_FASTCALL,
+	 "convert(raw, flat, memo, slow, eapi, eapi_attrs, uselist, matchall)\n"
+	 "The parse tree raw with every parser atom replaced by its Atom."},
+	{NULL}
+};
+
+static struct PyModuleDef cfast_module = {
+	PyModuleDef_HEAD_INIT,
+	.m_name = "_cfast",
+	.m_doc = "C fast paths of the dependency resolver",
+	.m_size = -1,
+	.m_methods = cfast_functions,
+};
+
+PyMODINIT_FUNC
+PyInit__cfast(void)
+{
+	PyObject *m, *type;
+
+	m = PyModule_Create(&cfast_module);
+	if (m == NULL)
+		return NULL;
+
+#define INTERN(var, text) \
+	do { \
+		var = PyUnicode_InternFromString(text); \
+		if (var == NULL) \
+			goto fail; \
+	} while (0)
+	INTERN(str_c_keymap, "_c_keymap");
+	INTERN(str_c_slow_keys, "_c_slow_keys");
+	INTERN(str_py_raw_getitem, "_py_raw_getitem");
+	INTERN(str_py_getitem, "_py_getitem");
+	INTERN(str_use, "_use");
+	INTERN(str_conditional, "conditional");
+#undef INTERN
+
+	type = PyType_FromSpec(&slotdict_spec);
+	if (type == NULL)
+		goto fail;
+	if (PyModule_AddObjectRef(m, "SlotDictBase", type) < 0) {
+		Py_DECREF(type);
+		goto fail;
+	}
+	Py_DECREF(type);
+	return m;
+
+fail:
+	Py_DECREF(m);
+	return NULL;
+}
diff -ruN a/src/portage_util__hashbase.c b/src/portage_util__hashbase.c
--- a/src/portage_util__hashbase.c
+++ b/src/portage_util__hashbase.c
@@ -0,0 +1,379 @@
+/* Copyright 2026 Gentoo Authors
+ * Distributed under the terms of the GNU General Public License v2
+ *
+ * C base types that carry the hash and equality of two resolver classes,
+ * so that dict and set operations on them do not call back into Python:
+ *
+ *   TaskBase  base of _emerge.Task (Package, Blocker): hashes by the stored
+ *             _hash_value and compares by _hash_key.
+ *   AtomBase  base of portage.dep.Atom: hashes and compares by _string.
+ *
+ * Both reproduce the Python methods they replace exactly, including which
+ * exception is raised when a field is unset and what is returned for a
+ * foreign operand. The Python bodies stay in Task.py and dep/__init__.py as
+ * the fallback for builds without native extensions, and are the reference:
+ * lib/portage/tests/util/test_hashbase.py compares the two.
+ */
+
+#define PY_SSIZE_T_CLEAN
+#include <Python.h>
+#include <stddef.h>
+
+static PyTypeObject *TaskBase_Type = NULL;
+static PyTypeObject *AtomBase_Type = NULL;
+static PyObject *str_hash_key = NULL;	/* interned "_hash_key" */
+
+/* ------------------------------------------------------------------ */
+/* shared helpers                                                       */
+
+static int
+unset_attribute(PyObject *self, const char *name)
+{
+	PyErr_Format(PyExc_AttributeError,
+		"'%.100s' object has no attribute '%s'",
+		Py_TYPE(self)->tp_name, name);
+	return -1;
+}
+
+static void
+base_dealloc_finish(PyObject *self)
+{
+	PyTypeObject *tp = Py_TYPE(self);
+	tp->tp_free(self);
+	Py_DECREF(tp);
+}
+
+/* ------------------------------------------------------------------ */
+/* TaskBase                                                             */
+
+typedef struct {
+	PyObject_HEAD
+	PyObject *hash_key;
+	PyObject *hash_value;
+} TaskBaseObject;
+
+static int
+taskbase_traverse(PyObject *op, visitproc visit, void *arg)
+{
+	TaskBaseObject *self = (TaskBaseObject *)op;
+	Py_VISIT(Py_TYPE(op));
+	Py_VISIT(self->hash_key);
+	Py_VISIT(self->hash_value);
+	return 0;
+}
+
+static int
+taskbase_clear(PyObject *op)
+{
+	TaskBaseObject *self = (TaskBaseObject *)op;
+	Py_CLEAR(self->hash_key);
+	Py_CLEAR(self->hash_value);
+	return 0;
+}
+
+static void
+taskbase_dealloc(PyObject *op)
+{
+	PyObject_GC_UnTrack(op);
+	(void)taskbase_clear(op);
+	base_dealloc_finish(op);
+}
+
+/* def __hash__(self): return self._hash_value
+ * followed by what CPython does with the result of a Python-level
+ * __hash__ (slot_tp_hash in Objects/typeobject.c). */
+static Py_hash_t
+taskbase_hash(PyObject *op)
+{
+	PyObject *value = ((TaskBaseObject *)op)->hash_value;
+	Py_hash_t h;
+
+	if (value == NULL)
+		return unset_attribute(op, "_hash_value");
+	if (!PyLong_Check(value)) {
+		PyErr_SetString(PyExc_TypeError,
+			"__hash__ method should return an integer");
+		return -1;
+	}
+	h = PyLong_AsSsize_t(value);
+	if (h == -1 && PyErr_Occurred()) {
+		PyErr_Clear();
+		h = PyLong_Type.tp_hash(value);
+	}
+	if (h == -1)
+		h = -2;
+	return h;
+}
+
+/* The key the other operand compares by: a new reference, or NULL with
+ * AttributeError (or another exception) set, as other._hash_key does. */
+static PyObject *
+task_other_key(PyObject *other)
+{
+	if (PyObject_TypeCheck(other, TaskBase_Type)) {
+		PyObject *key = ((TaskBaseObject *)other)->hash_key;
+		if (key == NULL) {
+			(void)unset_attribute(other, "_hash_key");
+			return NULL;
+		}
+		return Py_NewRef(key);
+	}
+	return PyObject_GetAttr(other, str_hash_key);
+}
+
+/*  def __eq__(self, other):
+ *      try:
+ *          return self._hash_key == other._hash_key
+ *      except AttributeError:
+ *          return self._hash_key == other
+ *
+ *  def __ne__(self, other):
+ *      try:
+ *          return self._hash_key != other._hash_key
+ *      except AttributeError:
+ *          return True
+ */
+static PyObject *
+taskbase_richcompare(PyObject *op, PyObject *other, int cmp)
+{
+	PyObject *key = ((TaskBaseObject *)op)->hash_key;
+	PyObject *other_key, *res;
+
+	if (cmp != Py_EQ && cmp != Py_NE)
+		Py_RETURN_NOTIMPLEMENTED;
+
+	if (key != NULL) {
+		other_key = task_other_key(other);
+		if (other_key != NULL) {
+			/* op may be released by the comparison */
+			Py_INCREF(key);
+			res = PyObject_RichCompare(key, other_key, cmp);
+			Py_DECREF(key);
+			Py_DECREF(other_key);
+			if (res != NULL)
+				return res;
+		}
+		if (!PyErr_ExceptionMatches(PyExc_AttributeError))
+			return NULL;
+		PyErr_Clear();
+	}
+
+	/* the "except AttributeError" branch */
+	if (cmp == Py_NE)
+		Py_RETURN_TRUE;
+	key = ((TaskBaseObject *)op)->hash_key;
+	if (key == NULL) {
+		(void)unset_attribute(op, "_hash_key");
+		return NULL;
+	}
+	Py_INCREF(key);
+	res = PyObject_RichCompare(key, other, Py_EQ);
+	Py_DECREF(key);
+	return res;
+}
+
+static PyMemberDef taskbase_members[] = {
+	{"_hash_key", Py_T_OBJECT_EX, offsetof(TaskBaseObject, hash_key), 0, NULL},
+	{"_hash_value", Py_T_OBJECT_EX, offsetof(TaskBaseObject, hash_value), 0, NULL},
+	{NULL}
+};
+
+static PyType_Slot taskbase_slots[] = {
+	{Py_tp_dealloc, taskbase_dealloc},
+	{Py_tp_traverse, taskbase_traverse},
+	{Py_tp_clear, taskbase_clear},
+	{Py_tp_hash, taskbase_hash},
+	{Py_tp_richcompare, taskbase_richcompare},
+	{Py_tp_members, taskbase_members},
+	{0, NULL}
+};
+
+static PyType_Spec taskbase_spec = {
+	.name = "portage.util._hashbase.TaskBase",
+	.basicsize = sizeof(TaskBaseObject),
+	.flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE | Py_TPFLAGS_HAVE_GC,
+	.slots = taskbase_slots,
+};
+
+/* ------------------------------------------------------------------ */
+/* AtomBase                                                             */
+
+typedef struct {
+	PyObject_HEAD
+	PyObject *string;
+} AtomBaseObject;
+
+static int
+atombase_traverse(PyObject *op, visitproc visit, void *arg)
+{
+	Py_VISIT(Py_TYPE(op));
+	Py_VISIT(((AtomBaseObject *)op)->string);
+	return 0;
+}
+
+static int
+atombase_clear(PyObject *op)
+{
+	Py_CLEAR(((AtomBaseObject *)op)->string);
+	return 0;
+}
+
+static void
+atombase_dealloc(PyObject *op)
+{
+	PyObject_GC_UnTrack(op);
+	(void)atombase_clear(op);
+	base_dealloc_finish(op);
+}
+
+/* def __hash__(self) -> int: return hash(self._string) */
+static Py_hash_t
+atombase_hash(PyObject *op)
+{
+	PyObject *string = ((AtomBaseObject *)op)->string;
+	Py_hash_t h;
+
+	if (string == NULL)
+		return unset_attribute(op, "_string");
+	Py_INCREF(string);
+	h = PyObject_Hash(string);
+	Py_DECREF(string);
+	return h;
+}
+
+/*  def __eq__(self, value):
+ *      if isinstance(value, Atom):
+ *          return self._string == value._string
+ *      if isinstance(value, str):
+ *          return self._string == value
+ *      return super().__eq__(value)      # object.__eq__: NotImplemented,
+ *                                        # an identical operand is an Atom
+ *  __ne__ is not defined, so it is object's: the inverse of __eq__ unless
+ *  that returns NotImplemented.
+ */
+static PyObject *
+atombase_eq(PyObject *op, PyObject *other)
+{
+	PyObject *string, *other_string, *res;
+	int other_is_atom = PyObject_TypeCheck(other, AtomBase_Type);
+
+	if (!other_is_atom && !PyUnicode_Check(other))
+		Py_RETURN_NOTIMPLEMENTED;
+
+	string = ((AtomBaseObject *)op)->string;
+	if (string == NULL) {
+		(void)unset_attribute(op, "_string");
+		return NULL;
+	}
+	if (other_is_atom) {
+		other_string = ((AtomBaseObject *)other)->string;
+		if (other_string == NULL) {
+			(void)unset_attribute(other, "_string");
+			return NULL;
+		}
+	}
+	else {
+		other_string = other;
+	}
+	Py_INCREF(string);
+	Py_INCREF(other_string);
+	res = PyObject_RichCompare(string, other_string, Py_EQ);
+	Py_DECREF(string);
+	Py_DECREF(other_string);
+	return res;
+}
+
+static PyObject *
+atombase_richcompare(PyObject *op, PyObject *other, int cmp)
+{
+	PyObject *res;
+	int truth;
+
+	if (cmp == Py_EQ)
+		return atombase_eq(op, other);
+	if (cmp != Py_NE)
+		Py_RETURN_NOTIMPLEMENTED;
+
+	res = atombase_eq(op, other);
+	if (res == NULL || res == Py_NotImplemented)
+		return res;
+	truth = PyObject_IsTrue(res);
+	Py_DECREF(res);
+	if (truth < 0)
+		return NULL;
+	return PyBool_FromLong(!truth);
+}
+
+static PyMemberDef atombase_members[] = {
+	{"_string", Py_T_OBJECT_EX, offsetof(AtomBaseObject, string), 0, NULL},
+	{NULL}
+};
+
+static PyType_Slot atombase_slots[] = {
+	{Py_tp_dealloc, atombase_dealloc},
+	{Py_tp_traverse, atombase_traverse},
+	{Py_tp_clear, atombase_clear},
+	{Py_tp_hash, atombase_hash},
+	{Py_tp_richcompare, atombase_richcompare},
+	{Py_tp_members, atombase_members},
+	{0, NULL}
+};
+
+static PyType_Spec atombase_spec = {
+	.name = "portage.util._hashbase.AtomBase",
+	.basicsize = sizeof(AtomBaseObject),
+	.flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE | Py_TPFLAGS_HAVE_GC,
+	.slots = atombase_slots,
+};
+
+/* ------------------------------------------------------------------ */
+/* module                                                               */
+
+static struct PyModuleDef hashbase_module = {
+	PyModuleDef_HEAD_INIT,
+	.m_name = "_hashbase",
+	.m_doc = "C base types with the hash and equality of Task and Atom",
+	.m_size = -1,
+};
+
+PyMODINIT_FUNC
+PyInit__hashbase(void)
+{
+	PyObject *m, *slots;
+
+	m = PyModule_Create(&hashbase_module);
+	if (m == NULL)
+		return NULL;
+
+	str_hash_key = PyUnicode_InternFromString("_hash_key");
+	if (str_hash_key == NULL)
+		goto fail;
+
+	TaskBase_Type = (PyTypeObject *)PyType_FromSpec(&taskbase_spec);
+	if (TaskBase_Type == NULL)
+		goto fail;
+	/* SlotObject.__init__ and SlotObject.copy() walk __slots__ of every
+	 * base class: name the two fields there as Task.__slots__ did. */
+	slots = Py_BuildValue("(ss)", "_hash_key", "_hash_value");
+	if (slots == NULL)
+		goto fail;
+	if (PyObject_SetAttrString((PyObject *)TaskBase_Type, "__slots__", slots) < 0) {
+		Py_DECREF(slots);
+		goto fail;
+	}
+	Py_DECREF(slots);
+	if (PyModule_AddObjectRef(m, "TaskBase", (PyObject *)TaskBase_Type) < 0)
+		goto fail;
+
+	AtomBase_Type = (PyTypeObject *)PyType_FromSpec(&atombase_spec);
+	if (AtomBase_Type == NULL)
+		goto fail;
+	if (PyModule_AddObjectRef(m, "AtomBase", (PyObject *)AtomBase_Type) < 0)
+		goto fail;
+
+	return m;
+
+fail:
+	Py_DECREF(m);
+	return NULL;
+}
