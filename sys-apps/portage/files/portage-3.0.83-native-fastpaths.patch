+/*  def __int__(self):                               (DepPriority)
+ *      if self.optional: return -5
+ *      if self.buildtime_slot_op: return 0
+ *      if self.buildtime: return -1
+ *      if self.runtime_slot_op: return -2
+ *      if self.runtime: return -3
+ *      if self.runtime_post: return -4
+ *      return -6
