+def test_priority_value_from_slots_matches_int_method():
+    from _emerge.DepPriority import DepPriority
+
+    for bits in itertools.product((False, True, None, 0, 1, "x", ""), repeat=3):
+        for rest in itertools.product((False, True), repeat=3):
+            p = DepPriority(**dict(zip(FLAGS, bits + rest)))
+            value = py_priority_int(p)
+            # p == value compares the C-read value with the method's value
+            assert p == value and not (p != value) and p >= value and p <= value
+            assert not (p < value) and not (p > value)
+            assert (p < value + 1) and (p > value - 1)
+
+
+def test_priority_bisect_and_sort_match_python():
+    import bisect
+
+    from _emerge.DepPriority import DepPriority
+
+    rng = random.Random(3)
+    prios = [DepPriority(**{rng.choice(FLAGS): True}) for _ in range(300)]
+    out_c = []
+    for p in prios:
+        bisect.insort_right(out_c, p)
+    out_py = []
+    for p in prios:
+        bisect.insort_right(out_py, p, key=py_priority_int)
+    assert [id(p) for p in out_c] == [id(p) for p in out_py]
+    assert [id(p) for p in sorted(prios)] == [id(p) for p in sorted(prios, key=py_priority_int)]
+    c = prios[0].copy()
+    assert c == prios[0] and c is not prios[0] and type(c) is DepPriority
+
+
+# ---- cmp_sort_key ----------------------------------------------------------
+
+
+def test_cmp_sort_key_matches_python():
+    from portage.util import cmp_sort_key
+
+    assert cmp_sort_key is _hashbase.cmp_sort_key
+    assert _py_cmp_sort_key is not cmp_sort_key
+
+    def raising(x, y):
+        raise ValueError("cmp")
+
+    cmps = [
+        lambda x, y: (x > y) - (x < y),
+        lambda x, y: y - x,
+        lambda x, y: 0,
+        lambda x, y: float(x - y),
+        lambda x, y: None,  # "None < 0" raises TypeError
+        lambda x, y: "text",
+        raising,
+    ]
+    rng = random.Random(5)
+    lists = [[], [1], [2, 1], [rng.randrange(50) for _ in range(200)]]
+    for cmp_func in cmps:
+        for data in lists:
+            expected = outcome(lambda: sorted(data, key=_py_cmp_sort_key(cmp_func)))
+            got = outcome(lambda: sorted(data, key=cmp_sort_key(cmp_func)))
+            assert got == expected, (cmp_func, len(data), got, expected)
+            expected = outcome(lambda: max(data, key=_py_cmp_sort_key(cmp_func)))
+            got = outcome(lambda: max(data, key=cmp_sort_key(cmp_func)))
+            assert got == expected
+
+    key = cmp_sort_key(cmps[0])
+    assert key._cmp_func is cmps[0]
+    k1, k2 = key(1), key(2)
+    assert type(k1) is cmp_sort_key._cmp_key and k1._obj == 1 and k1._cmp_func is cmps[0]
+    assert (k1 < k2) is True and (k2 < k1) is False
+    for other in (5, None, _py_cmp_sort_key(cmps[0])(1)):
+        with pytest.raises(TypeError):
+            k1 < other
+    pk1 = _py_cmp_sort_key(cmps[0])(1)
+    with pytest.raises(TypeError):
+        pk1 < 5
+    with pytest.raises(TypeError):
+        cmp_sort_key()
+    with pytest.raises(TypeError):
+        key(1, 2)
+    assert cmp_sort_key(cmp_func=cmps[1])(3)._obj == 3
