+
+def priority_cases():
+    from _emerge.BlockerDepPriority import BlockerDepPriority
+    from _emerge.DepPriority import DepPriority
+    from _emerge.UnmergeDepPriority import UnmergeDepPriority
+
+    cases = []
+    for bits in itertools.product((False, True), repeat=6):
+        cases.append(DepPriority(**dict(zip(FLAGS, bits))))
+    cases.append(DepPriority(buildtime=1, runtime="yes"))  # truthy, not bool
+    cases.append(DepPriority(optional=0, runtime=[1]))
+    cases.append(DepPriority())  # every flag None
+    raw = object.__new__(DepPriority)  # no slot set: __int__ raises
+    cases.append(raw)
+
+    class Sub(DepPriority):
+        __slots__ = ()
+
+        def __int__(self):
+            return 42
+
+    cases.append(Sub(buildtime=True))
+    cases.append(BlockerDepPriority())
+    cases.append(UnmergeDepPriority(runtime=True))
+    cases.append(UnmergeDepPriority(optional=True))
+    return cases
