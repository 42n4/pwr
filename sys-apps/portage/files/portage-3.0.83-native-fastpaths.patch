+@pytest.mark.skipif(dep._c_dep_parser is None, reason="no C dependency parser")
+def test_convert_matches_python():
+    n = 0
+    for depstr, uselist, eapi, matchall, flat in itertools.product(
+        DEPSTRINGS, USELISTS, EAPIS, (False, True), (False, True)
+    ):
+        # twice: the first call fills the atom memo, the second one reads it
+        for _ in range(2):
+            expected = outcome(
+                lambda: py_fast_use_reduce(depstr, uselist, matchall, eapi, flat)
+            )
+            got = outcome(
+                lambda: dep._c_fast_use_reduce(depstr, uselist, matchall, eapi, flat)
+            )
+            where = (depstr, uselist, eapi, matchall, flat)
+            assert got[:2] == expected[:2], where
+            if got[0] == "value":
+                assert same_tree(got[2], expected[2]), (where, got[2], expected[2])
+            n += 1
+    assert n == len(DEPSTRINGS) * len(USELISTS) * len(EAPIS) * 8
+
