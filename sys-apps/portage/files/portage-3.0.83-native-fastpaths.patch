+
+"""
+The C base types of portage.util._hashbase against the Python methods they
+replace in _emerge.Task and portage.dep.Atom: same results, same exception
+types, same hash values, for every pair of operands below.
+"""
+
+import itertools
+
+import pytest
+
+from portage.dep import Atom
+from portage.util.SlotObject import SlotObject
+
+try:
+    from portage.util import _hashbase
+except ImportError:
+    _hashbase = None
+
+pytestmark = pytest.mark.skipif(
+    _hashbase is None, reason="native extensions are not built"
+)
+
+
+# ---- the reference: the Python bodies, copied from Task.py and dep/__init__.py
+
+
+class PyTask(SlotObject):
+    __slots__ = ("_hash_key", "_hash_value")
+
+    def __eq__(self, other):
+        try:
+            return self._hash_key == other._hash_key
+        except AttributeError:
+            return self._hash_key == other
+
+    def __ne__(self, other):
+        try:
+            return self._hash_key != other._hash_key
+        except AttributeError:
+            return True
+
+    def __hash__(self):
+        return self._hash_value
+
+
+class PyAtom:
+    __slots__ = ("__weakref__", "_string", "_cp")
+
+    def __eq__(self, value):
+        if isinstance(value, PyAtom):
+            return self._string == value._string
+        if isinstance(value, str):
+            return self._string == value
+        return super().__eq__(value)
+
+    def __hash__(self):
+        return hash(self._string)
+
+
+if _hashbase is not None:
+
+    class CTask(_hashbase.TaskBase, SlotObject):
+        __slots__ = ()
+
+    class CTaskSub(CTask):
+        # like Package: more slots, ordering methods, the explicit __hash__
+        __hash__ = CTask.__hash__
+        __slots__ = ("extra",)
+
+        def __lt__(self, other):
+            return self._hash_key < other._hash_key
+
+    class CAtom(_hashbase.AtomBase):
+        __slots__ = ("__weakref__", "_cp")
+
+
+class PyTaskSub(PyTask):
+    __hash__ = PyTask.__hash__
+    __slots__ = ("extra",)
+
+    def __lt__(self, other):
+        return self._hash_key < other._hash_key
+
+
+class Odd:
+    """A foreign operand with a _hash_key of its own."""
+
+    def __init__(self, key):
+        self._hash_key = key
+
+
+class Raiser:
+    """Its _hash_key raises something other than AttributeError."""
+
+    @property
+    def _hash_key(self):
+        raise ValueError("boom")
+
+
+class EqAttributeError:
+    """A key element whose comparison raises AttributeError."""
+
+    def __eq__(self, other):
+        raise AttributeError("from __eq__")
+
+    def __hash__(self):
+        return 7
+
+
+def outcome(func):
+    """The result of func(), or the exception type it raised."""
+    try:
+        result = func()
+    except Exception as e:  # noqa: BLE001 - the type is the result
+        return ("raised", type(e))
+    if result is NotImplemented:
+        return ("NotImplemented",)
+    return ("value", type(result), result)
+
+
+KEYS = [
+    ("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo"),
+    ("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo"),  # equal, not identical
+    ("ebuild", "/", "dev-libs/foo-2", "merge", "gentoo"),
+    ("installed", "/", "dev-libs/foo-1", "nomerge", "gentoo"),
+    ("blocks", "/", "!dev-libs/foo", "8"),
+    (),
+    "a string key",
+    42,
+    None,
+]
+
+
+def make_tasks(cls, sub):
+    tasks = []
+    for key in KEYS:
+        for c in (cls, sub):
+            t = c()
+            t._hash_key = key
+            t._hash_value = hash(key)
+            tasks.append(t)
+    unset = object.__new__(cls)  # neither field set
+    odd_hash = cls()
+    odd_hash._hash_key = ("x",)
+    odd_hash._hash_value = 2**70 + 3  # outside Py_hash_t
+    minus_one = cls()
+    minus_one._hash_key = ("y",)
+    minus_one._hash_value = -1
+    bad_eq = cls()
+    bad_eq._hash_key = (EqAttributeError(),)
+    bad_eq._hash_value = 5
+    return tasks + [unset, odd_hash, minus_one, bad_eq]
+
+
+FOREIGN = [
+    ("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo"),
+    ["ebuild"],
+    "a string key",
+    42,
+    None,
+    3.5,
+    Odd(("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo")),
+    Odd(("other",)),
+    Raiser(),
+    object(),
+]
+
+
+def test_task_fields_and_slots():
+    assert _hashbase.TaskBase.__slots__ == ("_hash_key", "_hash_value")
+    t = CTask()
+    # SlotObject.__init__ set both to None, as it does for the Python class
+    assert t._hash_key is None and t._hash_value is None
+    raw = object.__new__(CTask)
+    with pytest.raises(AttributeError):
+        raw._hash_key
+    with pytest.raises(AttributeError):
+        raw._hash_value
+    t._hash_key = ("k",)
+    t._hash_value = 9
+    c = t.copy()
+    assert c._hash_key == ("k",) and c._hash_value == 9 and c == t
+    del t._hash_key
+    with pytest.raises(AttributeError):
+        t._hash_key
+
+
+def test_task_keyword_constructor():
+    t = CTaskSub(extra=1)
+    assert t.extra == 1 and t._hash_key is None
+    with pytest.raises(TypeError):
+        CTaskSub(nosuch=1)
+
+
+def test_task_compare_matches_python():
+    py = make_tasks(PyTask, PyTaskSub)
+    c = make_tasks(CTask, CTaskSub)
+    assert len(py) == len(c)
+    for (i, a_py), (j, b_py) in itertools.product(enumerate(py), repeat=2):
+        a_c, b_c = c[i], c[j]
+        for name, op in (("eq", lambda x, y: x == y), ("ne", lambda x, y: x != y)):
+            expected = outcome(lambda: op(a_py, b_py))
+            got = outcome(lambda: op(a_c, b_c))
+            assert got == expected, (name, i, j, got, expected)
+    for i, a_py in enumerate(py):
+        a_c = c[i]
+        for k, other in enumerate(FOREIGN):
+            for name, op in (
+                ("eq", lambda x, y: x == y),
+                ("ne", lambda x, y: x != y),
+                ("req", lambda x, y: y == x),
+                ("rne", lambda x, y: y != x),
+                ("dunder_eq", lambda x, y: x.__eq__(y)),
+                ("dunder_ne", lambda x, y: x.__ne__(y)),
+            ):
+                expected = outcome(lambda: op(a_py, other))
+                got = outcome(lambda: op(a_c, other))
+                assert got == expected, (name, i, k, got, expected)
+        for name in ("__lt__", "__le__", "__gt__", "__ge__"):
+            if isinstance(a_py, PyTaskSub) and name == "__lt__":
+                continue
+            assert outcome(lambda: getattr(a_c, name)(a_c)) == outcome(
+                lambda: getattr(a_py, name)(a_py)
+            )
+
+
+def test_task_hash_matches_python():
+    py = make_tasks(PyTask, PyTaskSub)
+    c = make_tasks(CTask, CTaskSub)
+    for a_py, a_c in zip(py, c):
+        assert outcome(lambda: hash(a_c)) == outcome(lambda: hash(a_py))
+    for bad in ("text", 1.5, None):
+        t_py, t_c = PyTask(), CTask()
+        t_py._hash_value = t_c._hash_value = bad
+        assert outcome(lambda: hash(t_c)) == outcome(lambda: hash(t_py))
