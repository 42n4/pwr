+def test_real_classes_use_the_c_bases():
+    from _emerge.Blocker import Blocker
+    from _emerge.Package import Package
+    from _emerge.Task import Task
+    from portage.dep import Atom
+
+    assert issubclass(Task, _hashbase.TaskBase)
+    assert issubclass(Atom, _hashbase.AtomBase)
+    for cls in (Task, Package, Blocker):
+        assert cls.__hash__ is _hashbase.TaskBase.__hash__
+        assert "__eq__" not in cls.__dict__
+    assert "_string" not in Atom.__slots__
+    a = Atom("dev-libs/foo")
+    assert a == "dev-libs/foo" and a == Atom("dev-libs/foo") and a != Atom("dev-libs/bar")
+    assert hash(a) == hash("dev-libs/foo")
+    b = Blocker(atom=Atom("!dev-libs/foo"), eapi="8", root="/")
+    assert b == ("blocks", "/", Atom("!dev-libs/foo"), "8")
+    assert hash(b) == hash(("blocks", "/", Atom("!dev-libs/foo"), "8"))
