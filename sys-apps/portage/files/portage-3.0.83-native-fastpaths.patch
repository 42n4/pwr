+# ---- ordering of Package ---------------------------------------------------
+
+import operator  # noqa: E402
+import random  # noqa: E402
+
+OPS = (
+    ("lt", operator.lt, "_py_lt"),
+    ("le", operator.le, "_py_le"),
+    ("gt", operator.gt, "_py_gt"),
+    ("ge", operator.ge, "_py_ge"),
+)
