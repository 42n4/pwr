+def test_package_ordering_matches_python():
+    from _emerge.Blocker import Blocker
+    from _emerge.Package import Package
+
+    class SubPackage(Package):
+        __slots__ = ()
+
+    sub = object.__new__(SubPackage)
+    sub.cp, sub.version, sub.built = "dev-libs/foo", "1.5", False
+    sub._hash_key = ("sub",)
+    sub._hash_value = 1
+    blocker = Blocker(atom=Atom("!dev-libs/foo"), eapi="8", root="/")
+    pkgs = package_cases() + [sub]
+    others = pkgs + [blocker, 5, None, "dev-libs/foo", object(), 1.5]
+    n = 0
+    for a in pkgs:
+        for b in others:
+            for name, op, py_name in OPS:
+                expected = outcome(lambda: getattr(Package, py_name)(a, b))
+                got = outcome(lambda: op(a, b))
+                assert got == expected, (name, a._hash_key, getattr(b, "_hash_key", b), got, expected)
+                # the method called directly, as min() and sort() do
+                got = outcome(lambda: getattr(type(a), f"__{name}__")(a, b))
+                assert got == expected, (name, "direct", a._hash_key, got, expected)
+                n += 1
+    assert n == len(pkgs) * len(others) * 4
+    # reflected: a foreign left operand falls back on the Package's method
+    for b in pkgs[:6]:
+        assert outcome(lambda: 5 < b) == outcome(lambda: Package._py_gt(b, 5))
