+/* ------------------------------------------------------------------ */
+/* ordering of Package                                                  */
+
+/* Set by register_package(): the exact class, the offsets of three of its
+ * slots, portage.versions.vercmp and the Python methods (the reference,
+ * and the answer for every unusual operand). */
+static PyTypeObject *Package_Type = NULL;
+static Py_ssize_t pkg_off_cp = -1, pkg_off_version = -1, pkg_off_built = -1;
+static PyObject *pkg_vercmp = NULL;
+static PyObject *pkg_py_compare[6] = {NULL, NULL, NULL, NULL, NULL, NULL};
+static PyObject *str_build_time = NULL;
+
+#define SLOT_AT(obj, offset) (*(PyObject **)((char *)(obj) + (offset)))
+
+/* The offset of an ordinary slot of tp (a member descriptor for an object
+ * that raises AttributeError when unset), or -1. */
+static Py_ssize_t
+slot_offset(PyTypeObject *tp, const char *name)
+{
+	PyObject *descr = PyObject_GetAttrString((PyObject *)tp, name);
+	Py_ssize_t offset = -1;
+
+	if (descr == NULL) {
+		PyErr_Clear();
+		return -1;
+	}
+	if (Py_IS_TYPE(descr, &PyMemberDescr_Type)) {
+		PyMemberDescrObject *md = (PyMemberDescrObject *)descr;
+		if (md->d_member->type == Py_T_OBJECT_EX
+			&& PyType_IsSubtype(tp, md->d_common.d_type))
+			offset = md->d_member->offset;
+	}
+	Py_DECREF(descr);
+	return offset;
+}
+
+static int
+truth_of(PyObject *a, PyObject *b, int op)
+{
+	PyObject *res = PyObject_RichCompare(a, b, op);
+	int truth;
+
+	if (res == NULL)
+		return -1;
+	truth = PyObject_IsTrue(res);
+	Py_DECREF(res);
+	return truth;
+}
+
+/*  def __lt__(self, other):                    (__le__, __gt__, __ge__ alike)
+ *      if other.cp != self.cp:
+ *          return self.cp < other.cp
+ *      result = portage.vercmp(self.version, other.version)
+ *      if result < 0:
+ *          return True
+ *      if result == 0 and self.built and other.built:
+ *          return self.build_time < other.build_time
+ *      return False
+ *
+ * For two instances of exactly Package with these slots set and an int from
+ * vercmp(); the Python method for anything else. */
+static PyObject *
+package_order(PyObject *self, PyObject *other, int op)
+{
+	PyObject *scp, *ocp, *sver, *over, *result, *a, *b, *res;
+	int truth, overflow;
+	long r;
+
+	if (Py_TYPE(self) != Package_Type || Py_TYPE(other) != Package_Type)
+		goto python;
+	scp = SLOT_AT(self, pkg_off_cp);
+	ocp = SLOT_AT(other, pkg_off_cp);
+	if (scp == NULL || ocp == NULL)
+		goto python;
+	Py_INCREF(scp);
+	Py_INCREF(ocp);
+	truth = truth_of(ocp, scp, Py_NE);
+	if (truth < 0) {
+		Py_DECREF(scp);
+		Py_DECREF(ocp);
+		return NULL;
+	}
+	if (truth) {
+		res = PyObject_RichCompare(scp, ocp, op);
+		Py_DECREF(scp);
+		Py_DECREF(ocp);
+		return res;
+	}
+	Py_DECREF(scp);
+	Py_DECREF(ocp);
+
+	sver = SLOT_AT(self, pkg_off_version);
+	over = SLOT_AT(other, pkg_off_version);
+	if (sver == NULL || over == NULL)
+		goto python;
+	Py_INCREF(sver);
+	Py_INCREF(over);
+	result = PyObject_CallFunctionObjArgs(pkg_vercmp, sver, over, NULL);
+	Py_DECREF(sver);
+	Py_DECREF(over);
+	if (result == NULL)
+		return NULL;
+	if (!PyLong_CheckExact(result)) {
+		/* None for versions that cannot be compared: the Python method
+		 * raises what "None < 0" raises */
+		Py_DECREF(result);
+		goto python;
+	}
+	r = PyLong_AsLongAndOverflow(result, &overflow);
+	Py_DECREF(result);
+	if (overflow)
+		r = overflow;
+	else if (r == -1 && PyErr_Occurred())
+		return NULL;
+
+	if ((op == Py_LT && r < 0) || (op == Py_LE && r <= 0)
+		|| (op == Py_GT && r > 0) || (op == Py_GE && r >= 0))
+		Py_RETURN_TRUE;
+	if (r != 0)
+		Py_RETURN_FALSE;
+
+	/* result == 0 and self.built and other.built */
+	a = SLOT_AT(self, pkg_off_built);
+	if (a == NULL)
+		goto python;
+	Py_INCREF(a);
+	truth = PyObject_IsTrue(a);
+	Py_DECREF(a);
+	if (truth < 0)
+		return NULL;
+	if (!truth)
+		Py_RETURN_FALSE;
+	b = SLOT_AT(other, pkg_off_built);
+	if (b == NULL)
+		goto python;
+	Py_INCREF(b);
+	truth = PyObject_IsTrue(b);
+	Py_DECREF(b);
+	if (truth < 0)
+		return NULL;
+	if (!truth)
+		Py_RETURN_FALSE;
+	a = PyObject_GetAttr(self, str_build_time);
+	if (a == NULL)
+		return NULL;
+	b = PyObject_GetAttr(other, str_build_time);
+	if (b == NULL) {
+		Py_DECREF(a);
+		return NULL;
+	}
+	res = PyObject_RichCompare(a, b, op);
+	Py_DECREF(a);
+	Py_DECREF(b);
+	return res;
+
+python:
+	return PyObject_CallFunctionObjArgs(pkg_py_compare[op], self, other, NULL);
+}
+
+/* register_package(cls, vercmp, lt, le, gt, ge): returns True if instances
+ * of exactly cls are now ordered in C, False if cls does not have the three
+ * slots (then it keeps its Python methods). */
+static PyObject *
+hashbase_register_package(PyObject *Py_UNUSED(module), PyObject *args)
+{
+	PyObject *cls, *vercmp, *lt, *le, *gt, *ge;
+	PyTypeObject *tp;
+	Py_ssize_t cp, version, built;
+
+	if (!PyArg_ParseTuple(args, "OOOOOO:register_package",
+			&cls, &vercmp, &lt, &le, &gt, &ge))
+		return NULL;
+	if (!PyType_Check(cls) || !PyType_IsSubtype((PyTypeObject *)cls, TaskBase_Type)) {
+		PyErr_SetString(PyExc_TypeError,
+			"register_package: expected a subclass of TaskBase");
+		return NULL;
+	}
+	tp = (PyTypeObject *)cls;
+	cp = slot_offset(tp, "cp");
+	version = slot_offset(tp, "version");
+	built = slot_offset(tp, "built");
+	if (cp < 0 || version < 0 || built < 0)
+		Py_RETURN_FALSE;
+	pkg_off_cp = cp;
+	pkg_off_version = version;
+	pkg_off_built = built;
+	Py_XSETREF(pkg_vercmp, Py_NewRef(vercmp));
+	Py_XSETREF(pkg_py_compare[Py_LT], Py_NewRef(lt));
+	Py_XSETREF(pkg_py_compare[Py_LE], Py_NewRef(le));
+	Py_XSETREF(pkg_py_compare[Py_GT], Py_NewRef(gt));
+	Py_XSETREF(pkg_py_compare[Py_GE], Py_NewRef(ge));
+	Py_XSETREF(Package_Type, (PyTypeObject *)Py_NewRef(cls));
+	Py_RETURN_TRUE;
+}
