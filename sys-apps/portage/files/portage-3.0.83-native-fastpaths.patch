+static PyObject *
+cfast_set_keymap_builder(PyObject *Py_UNUSED(module), PyObject *func)
+{
+	if (!PyCallable_Check(func)) {
+		PyErr_SetString(PyExc_TypeError, "expected a callable");
+		return NULL;
+	}
+	Py_XSETREF(keymap_builder, Py_NewRef(func));
+	Py_RETURN_NONE;
+}
+
+/* ------------------------------------------------------------------ */
+/* convert()                                                            */
+
+typedef struct {
+	PyObject *memo;		/* {(token string, eapi): Atom} */
+	PyObject *slow;		/* _c_atom_from_c */
+	PyObject *eapi;
+	PyObject *eapi_attrs;
+	PyObject *uselist;
+	PyObject *matchall;
+	int matchall_true;
+} convert_ctx;
+
+/* _c_atom_from_c(catom, eapi, eapi_attrs, uselist, matchall) for a token
+ * whose Atom is remembered and needs no USE evaluation; the Python function
+ * for every other token. Returns a new reference. */
+static PyObject *
+convert_atom(PyObject *catom, convert_ctx *ctx)
+{
+	PyObject *token, *key, *atom, *use, *conditional;
+	int truth;
+
+	token = PyObject_Str(catom);
+	if (token == NULL)
+		return NULL;
+	key = PyTuple_Pack(2, token, ctx->eapi);
+	Py_DECREF(token);
+	if (key == NULL)
+		return NULL;
+	atom = PyDict_GetItemWithError(ctx->memo, key);
+	Py_XINCREF(atom);
+	Py_DECREF(key);
+	if (atom == NULL && PyErr_Occurred())
+		return NULL;
+
+	if (atom != NULL && atom != Py_None) {
+		if (ctx->matchall_true)
+			return atom;
+		use = PyObject_GetAttr(atom, str_use);
+		if (use == NULL) {
+			Py_DECREF(atom);
+			return NULL;
+		}
+		if (use == Py_None) {
+			Py_DECREF(use);
+			return atom;
+		}
+		conditional = PyObject_GetAttr(use, str_conditional);
+		Py_DECREF(use);
+		if (conditional == NULL) {
+			Py_DECREF(atom);
+			return NULL;
+		}
+		truth = PyObject_IsTrue(conditional);
+		Py_DECREF(conditional);
+		if (truth < 0) {
+			Py_DECREF(atom);
+			return NULL;
+		}
+		if (!truth)
+			return atom;
+	}
+	Py_XDECREF(atom);
+	return PyObject_CallFunctionObjArgs(ctx->slow, catom, ctx->eapi,
+		ctx->eapi_attrs, ctx->uselist, ctx->matchall, NULL);
+}
+
+/* Append the conversion of items to out: nested lists stay nested
+ * (_c_convert_result) or are spliced in (flat, _c_flatten_result). */
+static int
+convert_into(PyObject *items, PyObject *out, int flat, convert_ctx *ctx)
+{
+	Py_ssize_t i;
+	PyObject *item, *converted;
+	int rc;
+
+	if (Py_EnterRecursiveCall(" while converting a dependency string"))
+		return -1;
+	/* the list can change while Python code runs: re-read its size */
+	for (i = 0; i < PyList_GET_SIZE(items); i++) {
+		item = Py_NewRef(PyList_GET_ITEM(items, i));
+		if (PyUnicode_Check(item)) {
+			rc = PyList_Append(out, item);
+		}
+		else if (PyList_Check(item)) {
+			if (flat) {
+				rc = convert_into(item, out, 1, ctx);
+			}
+			else {
+				converted = PyList_New(0);
+				rc = -1;
+				if (converted != NULL) {
+					rc = convert_into(item, converted, 0, ctx);
+					if (rc == 0)
+						rc = PyList_Append(out, converted);
+					Py_DECREF(converted);
+				}
+			}
+		}
+		else {
+			converted = convert_atom(item, ctx);
+			rc = -1;
+			if (converted != NULL) {
+				rc = PyList_Append(out, converted);
+				Py_DECREF(converted);
+			}
+		}
+		Py_DECREF(item);
+		if (rc < 0) {
+			Py_LeaveRecursiveCall();
+			return -1;
+		}
+	}
+	Py_LeaveRecursiveCall();
+	return 0;
+}
+
+static PyObject *
+cfast_convert(PyObject *Py_UNUSED(module), PyObject *const *args, Py_ssize_t nargs)
+{
+	convert_ctx ctx;
+	PyObject *raw, *out;
+	int flat;
+
+	if (nargs != 8) {
+		PyErr_Format(PyExc_TypeError,
+			"convert expected 8 arguments, got %zd", nargs);
+		return NULL;
+	}
+	raw = args[0];
+	if (!PyList_Check(raw)) {
+		PyErr_SetString(PyExc_TypeError, "convert: the parse tree must be a list");
+		return NULL;
+	}
+	flat = PyObject_IsTrue(args[1]);
+	if (flat < 0)
+		return NULL;
+	ctx.memo = args[2];
+	if (!PyDict_Check(ctx.memo)) {
+		PyErr_SetString(PyExc_TypeError, "convert: the memo must be a dict");
+		return NULL;
+	}
+	ctx.slow = args[3];
+	ctx.eapi = args[4];
+	ctx.eapi_attrs = args[5];
+	ctx.uselist = args[6];
+	ctx.matchall = args[7];
+	ctx.matchall_true = PyObject_IsTrue(ctx.matchall);
+	if (ctx.matchall_true < 0)
+		return NULL;
+
+	out = PyList_New(0);
+	if (out == NULL)
+		return NULL;
+	if (convert_into(raw, out, flat, &ctx) < 0) {
+		Py_DECREF(out);
+		return NULL;
+	}
+	return out;
+}
