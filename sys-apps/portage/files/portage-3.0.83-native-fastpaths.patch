+    cases = priority_cases()
+    others = cases + [-6, -5, -3, 0, 42, 1.5, None, "x", object()]
+    ops = (
+        ("lt", operator.lt),
+        ("le", operator.le),
+        ("eq", operator.eq),
+        ("ne", operator.ne),
+        ("gt", operator.gt),
+        ("ge", operator.ge),
+    )
+    for a in cases:
+        for b in others:
+            for name, op in ops:
+                # the Python method: self.__int__() <op> other
+                expected = outcome(lambda: op(a.__int__(), b))
+                got = outcome(lambda: op(a, b))
+                assert got == expected, (name, a, b, got, expected)
+    # reflected: an int on the left ends in the priority's mirrored method
+    mirrored = {"lt": operator.gt, "le": operator.ge, "gt": operator.lt, "ge": operator.le,
+                "eq": operator.eq, "ne": operator.ne}
+    for a in cases:
