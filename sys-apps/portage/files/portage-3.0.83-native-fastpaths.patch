diff -ruN a/lib/portage/tests/util/test_cfast.py b/lib/portage/tests/util/test_cfast.py
--- a/lib/portage/tests/util/test_cfast.py
+++ b/lib/portage/tests/util/test_cfast.py
@@ -0,0 +1,297 @@
+# Copyright 2026 Gentoo Authors
+# Distributed under the terms of the GNU General Public License v2
+
+"""
+portage.util._cfast against the Python code it replaces: the slot dict
+lookups of portage.cache.mappings and the conversion of the C parser's tree
+in portage.dep. Same results and same exception types.
+"""
+
+import itertools
+
+import pytest
+
+import portage.dep as dep
+from portage.cache import mappings
+from portage.dep import Atom
+
+try:
+    from portage.util import _cfast
+except ImportError:
+    _cfast = None
+
+pytestmark = pytest.mark.skipif(_cfast is None, reason="native extensions are not built")
+
+
+def outcome(func):
+    try:
+        result = func()
+    except Exception as e:  # noqa: BLE001 - the type is the result
+        return ("raised", type(e))
+    return ("value", type(result), result)
+
+
+# ---- slot dict -----------------------------------------------------------
+
+
+def py_getitem(self, k):
+    """_SlotDict.__getitem__ before the C base."""
+    try:
+        return getattr(self, self._prefix + k)
+    except AttributeError:
+        raise KeyError(k)
+
+
+def py_get(self, key, default=None):
+    try:
+        return py_getitem(self, key)
+    except KeyError:
+        return default
+
+
+class StrSub(str):
+    pass
+
+
+KEYS = ["SLOT", "EAPI", "USE", "KEYWORDS", "DEFINED_PHASES"]
+PROBES = [
+    "SLOT",
+    "EAPI",
+    "USE",
+    "KEYWORDS",
+    "nope",
+    "",
+    StrSub("SLOT"),
+    StrSub("nope"),
+    Atom("dev-libs/foo"),
+    b"SLOT",
+    1,
+    None,
+    ("SLOT",),
+    ["SLOT"],
+    3.5,
+]
+
+
+def test_slot_dict_uses_the_c_base():
+    cls = mappings.slot_dict_class(KEYS)
+    assert issubclass(cls, _cfast.SlotDictBase)
+    assert "__getitem__" not in mappings._SlotDict.__dict__
+    assert "get" not in mappings._SlotDict.__dict__
+
+
+@pytest.mark.parametrize("prefix", ["_val_", "", "x"])
+def test_slot_dict_getitem_and_get_match_python(prefix):
+    cls = mappings.slot_dict_class(KEYS, prefix=prefix)
+    d = cls({"SLOT": "0/1", "EAPI": "8", "USE": ""})  # KEYWORDS, DEFINED_PHASES unset
+    for k in PROBES:
+        assert outcome(lambda: d[k]) == outcome(lambda: py_getitem(d, k)), (prefix, k)
+        assert outcome(lambda: d.get(k)) == outcome(lambda: py_get(d, k)), (prefix, k)
+        assert outcome(lambda: d.get(k, 7)) == outcome(lambda: py_get(d, k, 7)), (prefix, k)
+    assert d.get("KEYWORDS") is None and d.get("KEYWORDS", "x") == "x"
+    with pytest.raises(TypeError):
+        d.get()
+    with pytest.raises(TypeError):
+        d.get("SLOT", 1, 2)
+    # the keymap follows later changes of a value, deletion included
+    d["KEYWORDS"] = "amd64"
+    assert d["KEYWORDS"] == "amd64" and d.get("KEYWORDS") == "amd64"
+    del d["KEYWORDS"]
+    with pytest.raises(KeyError):
+        d["KEYWORDS"]
+    assert set(cls._c_keymap) == set(KEYS)
+
+
+def test_slot_dict_rest_of_the_mapping_api():
+    cls = mappings.slot_dict_class(KEYS)
+    d = cls(SLOT="0")
+    assert dict(d) == {"SLOT": "0"} and len(d) == 1 and "SLOT" in d
+    assert d.setdefault("EAPI", "8") == "8" and d.pop("EAPI") == "8"
+    assert d.pop("EAPI", "gone") == "gone"
+    c = d.copy()
+    assert c == d and c is not d and c["SLOT"] == "0"
+    d.update({"USE": "a b"})
+    assert sorted(d.items()) == [("SLOT", "0"), ("USE", "a b")]
+
+
+def test_slot_dict_subclass_with_python_getitem():
+    cls = mappings.slot_dict_class(KEYS)
+
+    class Loud(cls):
+        __slots__ = ()
+
+        def __getitem__(self, k):
+            return cls.__getitem__(self, k).upper()
+
+    d = Loud(SLOT="abc")
+    assert d["SLOT"] == "ABC"
+    # get() goes through the overriding __getitem__, as the Python get() did
+    assert d.get("SLOT") == "ABC" and d.get("EAPI", "dflt") == "dflt"
+
+
+def test_pickled_slot_dict_stays_on_python_path():
+    import pickle
+
+    cls = mappings.slot_dict_class(KEYS)
+    d = cls(SLOT="0", EAPI="8")
+    p = pickle.loads(pickle.dumps(d))
+    assert type(p) is mappings._PickledSlotDict
+    assert p["SLOT"] == "0" and p.get("EAPI") == "8" and p.get("USE", 5) == 5
+    assert type(p)._c_keymap == {}
+    with pytest.raises(KeyError):
+        p["USE"]
+
+
+def test_package_metadata_wrapper_hooked_getitem():
+    from _emerge.Package import _PackageMetadataWrapper as W
+    from _emerge.Package import _PackageMetadataWrapperBase as B
+
+    assert W.__dict__["__getitem__"] is _cfast.SlotDictBase._c_getitem_hooked
+    assert W._c_slow_keys == W._use_conditional_keys | {"USE"}
+
+    class FakePkg:
+        built = True
+
+    w = W.__new__(W)
+    B.__init__(w)
+    w._pkg = FakePkg()
+    B.__setitem__(w, "SLOT", "0")
+    B.__setitem__(w, "USE", "a b")
+    calls = []
+    orig = W._py_getitem
+
+    def spy(self, k):
+        calls.append(k)
+        return orig(self, k)
+
+    W._py_getitem = spy
+    try:
+        assert w["SLOT"] == "0" and calls == []  # plain key: no Python call
+        assert w["USE"] == "a b" and calls == ["USE"]  # special key: Python method
+        assert w.get("SLOT") == "0" and w.get("EAPI", "x") == "x"
+        with pytest.raises(KeyError):
+            w["EAPI"]
+        for k in PROBES:
+            assert outcome(lambda: w[k]) == outcome(lambda: orig(w, k)), k
+    finally:
+        W._py_getitem = orig
+    # the raw base lookup has no hook, for a wrapper instance too
+    assert B.__getitem__(w, "USE") == "a b"
+
+
+# ---- convert() -----------------------------------------------------------
+
+DEPSTRINGS = [
+    "",
+    "dev-libs/a",
+    "dev-libs/a dev-libs/b",
+    ">=dev-libs/a-1.2:0= !dev-libs/b !!<dev-libs/c-3 ~dev-libs/d-1 =dev-libs/e-2*",
+    "|| ( dev-libs/a dev-libs/b )",
+    "|| ( dev-libs/a ( dev-libs/b dev-libs/c ) )",
+    "|| ( ( dev-libs/a ) )",
+    "|| ( || ( dev-libs/a dev-libs/b ) dev-libs/c )",
+    "|| ( )",
+    "x? ( dev-libs/a ) !x? ( dev-libs/b )",
+    "x? ( y? ( dev-libs/a ) || ( dev-libs/b z? ( dev-libs/c ) ) )",
+    "dev-libs/a[x,y?,-z,w=,!v?] dev-libs/b[x(+),y(-)?]",
+    "dev-libs/a:2/3= dev-libs/b:* dev-libs/c:=",
+    "( dev-libs/a ( dev-libs/b ) ) dev-libs/c",
+    "x? ( ) dev-libs/a",
+    "dev-libs/a::gentoo",
+]
+USELISTS = [(), ("x",), ("x", "y"), ("y", "z", "w", "v")]
+EAPIS = ["8", "7", "6", None]
+
+
+def py_fast_use_reduce(depstr, uselist, matchall, eapi, flat):
+    """_c_fast_use_reduce with the Python conversion."""
+    saved = dep._c_convert
+    dep._c_convert = None
+    try:
+        return dep._c_fast_use_reduce(depstr, uselist, matchall, eapi, flat)
+    finally:
+        dep._c_convert = saved
+
+
+def same_tree(a, b):
+    """Same nesting, types and strings; the very same Atom objects (both
+    trees are alive, so the weak intern caches hand out one instance)."""
+    if isinstance(a, list) or isinstance(b, list):
+        return (
+            type(a) is type(b)
+            and len(a) == len(b)
+            and all(same_tree(x, y) for x, y in zip(a, b))
+        )
+    if isinstance(a, Atom) or isinstance(b, Atom):
+        return a is b
+    return type(a) is type(b) and a == b
+
+
+@pytest.mark.skipif(dep._c_dep_parser is None, reason="no C dependency parser")
+def test_convert_matches_python():
+    n = 0
+    for depstr, uselist, eapi, matchall, flat in itertools.product(
+        DEPSTRINGS, USELISTS, EAPIS, (False, True), (False, True)
+    ):
+        # twice: the first call fills the atom memo, the second one reads it
+        for _ in range(2):
+            expected = outcome(
+                lambda: py_fast_use_reduce(depstr, uselist, matchall, eapi, flat)
+            )
+            got = outcome(
+                lambda: dep._c_fast_use_reduce(depstr, uselist, matchall, eapi, flat)
+            )
+            where = (depstr, uselist, eapi, matchall, flat)
+            assert got[:2] == expected[:2], where
+            if got[0] == "value":
+                assert same_tree(got[2], expected[2]), (where, got[2], expected[2])
+            n += 1
+    assert n == len(DEPSTRINGS) * len(USELISTS) * len(EAPIS) * 8
+
+
+def test_convert_argument_checks_and_errors():
+    with pytest.raises(TypeError):
+        _cfast.convert([], False, {}, None, "8", None, (), False, "extra")
+    with pytest.raises(TypeError):
+        _cfast.convert((), False, {}, None, "8", None, (), False)
+    with pytest.raises(TypeError):
+        _cfast.convert([], False, [], None, "8", None, (), False)
+
+    class Token:
+        def __str__(self):
+            return "tok"
+
+    def boom(*args):
+        raise ValueError("from the slow path")
+
+    with pytest.raises(ValueError):
+        _cfast.convert([Token()], False, {}, boom, "8", None, (), False)
+
+    seen = []
+
+    def slow(catom, eapi, eapi_attrs, uselist, matchall):
+        seen.append((str(catom), eapi, eapi_attrs, uselist, matchall))
+        return "converted"
+
+    t = Token()
+    assert _cfast.convert(["||", [t, [t]], t], False, {}, slow, "8", "attrs", ("u",), 0) == [
+        "||",
+        ["converted", ["converted"]],
+        "converted",
+    ]
+    assert seen[0] == ("tok", "8", "attrs", ("u",), 0) and len(seen) == 3
+    assert _cfast.convert(["||", [t, [t]], t], True, {}, slow, "8", None, (), 0) == [
+        "||",
+        "converted",
+        "converted",
+        "converted",
+    ]
+    # a remembered value of None is not a hit, as in the Python code
+    assert _cfast.convert([t], False, {("tok", "8"): None}, slow, "8", None, (), 1) == [
+        "converted"
+    ]
+    # a remembered atom is returned as it is when matchall is true
+    marker = object()
+    assert _cfast.convert([t], False, {("tok", "8"): marker}, boom, "8", None, (), 1) == [
+        marker
+    ]
diff -ruN a/lib/portage/tests/util/test_hashbase.py b/lib/portage/tests/util/test_hashbase.py
--- a/lib/portage/tests/util/test_hashbase.py
+++ b/lib/portage/tests/util/test_hashbase.py
@@ -0,0 +1,336 @@
+# Copyright 2026 Gentoo Authors
+# Distributed under the terms of the GNU General Public License v2
+
+"""
+The C base types of portage.util._hashbase against the Python methods they
+replace in _emerge.Task and portage.dep.Atom: same results, same exception
+types, same hash values, for every pair of operands below.
+"""
+
+import itertools
+
+import pytest
+
+from portage.util.SlotObject import SlotObject
+
+try:
+    from portage.util import _hashbase
+except ImportError:
+    _hashbase = None
+
+pytestmark = pytest.mark.skipif(
+    _hashbase is None, reason="native extensions are not built"
+)
+
+
+# ---- the reference: the Python bodies, copied from Task.py and dep/__init__.py
+
+
+class PyTask(SlotObject):
+    __slots__ = ("_hash_key", "_hash_value")
+
+    def __eq__(self, other):
+        try:
+            return self._hash_key == other._hash_key
+        except AttributeError:
+            return self._hash_key == other
+
+    def __ne__(self, other):
+        try:
+            return self._hash_key != other._hash_key
+        except AttributeError:
+            return True
+
+    def __hash__(self):
+        return self._hash_value
+
+
+class PyAtom:
+    __slots__ = ("__weakref__", "_string", "_cp")
+
+    def __eq__(self, value):
+        if isinstance(value, PyAtom):
+            return self._string == value._string
+        if isinstance(value, str):
+            return self._string == value
+        return super().__eq__(value)
+
+    def __hash__(self):
+        return hash(self._string)
+
+
+if _hashbase is not None:
+
+    class CTask(_hashbase.TaskBase, SlotObject):
+        __slots__ = ()
+
+    class CTaskSub(CTask):
+        # like Package: more slots, ordering methods, the explicit __hash__
+        __hash__ = CTask.__hash__
+        __slots__ = ("extra",)
+
+        def __lt__(self, other):
+            return self._hash_key < other._hash_key
+
+    class CAtom(_hashbase.AtomBase):
+        __slots__ = ("__weakref__", "_cp")
+
+
+class PyTaskSub(PyTask):
+    __hash__ = PyTask.__hash__
+    __slots__ = ("extra",)
+
+    def __lt__(self, other):
+        return self._hash_key < other._hash_key
+
+
+class Odd:
+    """A foreign operand with a _hash_key of its own."""
+
+    def __init__(self, key):
+        self._hash_key = key
+
+
+class Raiser:
+    """Its _hash_key raises something other than AttributeError."""
+
+    @property
+    def _hash_key(self):
+        raise ValueError("boom")
+
+
+class EqAttributeError:
+    """A key element whose comparison raises AttributeError."""
+
+    def __eq__(self, other):
+        raise AttributeError("from __eq__")
+
+    def __hash__(self):
+        return 7
+
+
+def outcome(func):
+    """The result of func(), or the exception type it raised."""
+    try:
+        result = func()
+    except Exception as e:  # noqa: BLE001 - the type is the result
+        return ("raised", type(e))
+    if result is NotImplemented:
+        return ("NotImplemented",)
+    return ("value", type(result), result)
+
+
+KEYS = [
+    ("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo"),
+    ("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo"),  # equal, not identical
+    ("ebuild", "/", "dev-libs/foo-2", "merge", "gentoo"),
+    ("installed", "/", "dev-libs/foo-1", "nomerge", "gentoo"),
+    ("blocks", "/", "!dev-libs/foo", "8"),
+    (),
+    "a string key",
+    42,
+    None,
+]
+
+
+def make_tasks(cls, sub):
+    tasks = []
+    for key in KEYS:
+        for c in (cls, sub):
+            t = c()
+            t._hash_key = key
+            t._hash_value = hash(key)
+            tasks.append(t)
+    unset = object.__new__(cls)  # neither field set
+    odd_hash = cls()
+    odd_hash._hash_key = ("x",)
+    odd_hash._hash_value = 2**70 + 3  # outside Py_hash_t
+    minus_one = cls()
+    minus_one._hash_key = ("y",)
+    minus_one._hash_value = -1
+    bad_eq = cls()
+    bad_eq._hash_key = (EqAttributeError(),)
+    bad_eq._hash_value = 5
+    return tasks + [unset, odd_hash, minus_one, bad_eq]
+
+
+FOREIGN = [
+    ("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo"),
+    ["ebuild"],
+    "a string key",
+    42,
+    None,
+    3.5,
+    Odd(("ebuild", "/", "dev-libs/foo-1", "merge", "gentoo")),
+    Odd(("other",)),
+    Raiser(),
+    object(),
+]
+
+
+def test_task_fields_and_slots():
+    assert _hashbase.TaskBase.__slots__ == ("_hash_key", "_hash_value")
+    t = CTask()
+    # SlotObject.__init__ set both to None, as it does for the Python class
+    assert t._hash_key is None and t._hash_value is None
+    raw = object.__new__(CTask)
+    with pytest.raises(AttributeError):
+        raw._hash_key
+    with pytest.raises(AttributeError):
+        raw._hash_value
+    t._hash_key = ("k",)
+    t._hash_value = 9
+    c = t.copy()
+    assert c._hash_key == ("k",) and c._hash_value == 9 and c == t
+    del t._hash_key
+    with pytest.raises(AttributeError):
+        t._hash_key
+
+
+def test_task_keyword_constructor():
+    t = CTaskSub(extra=1)
+    assert t.extra == 1 and t._hash_key is None
+    with pytest.raises(TypeError):
+        CTaskSub(nosuch=1)
+
+
+def test_task_compare_matches_python():
+    py = make_tasks(PyTask, PyTaskSub)
+    c = make_tasks(CTask, CTaskSub)
+    assert len(py) == len(c)
+    for (i, a_py), (j, b_py) in itertools.product(enumerate(py), repeat=2):
+        a_c, b_c = c[i], c[j]
+        for name, op in (("eq", lambda x, y: x == y), ("ne", lambda x, y: x != y)):
+            expected = outcome(lambda: op(a_py, b_py))
+            got = outcome(lambda: op(a_c, b_c))
+            assert got == expected, (name, i, j, got, expected)
+    for i, a_py in enumerate(py):
+        a_c = c[i]
+        for k, other in enumerate(FOREIGN):
+            for name, op in (
+                ("eq", lambda x, y: x == y),
+                ("ne", lambda x, y: x != y),
+                ("req", lambda x, y: y == x),
+                ("rne", lambda x, y: y != x),
+                ("dunder_eq", lambda x, y: x.__eq__(y)),
+                ("dunder_ne", lambda x, y: x.__ne__(y)),
+            ):
+                expected = outcome(lambda: op(a_py, other))
+                got = outcome(lambda: op(a_c, other))
+                assert got == expected, (name, i, k, got, expected)
+        for name in ("__lt__", "__le__", "__gt__", "__ge__"):
+            if isinstance(a_py, PyTaskSub) and name == "__lt__":
+                continue
+            assert outcome(lambda: getattr(a_c, name)(a_c)) == outcome(
+                lambda: getattr(a_py, name)(a_py)
+            )
+
+
+def test_task_hash_matches_python():
+    py = make_tasks(PyTask, PyTaskSub)
+    c = make_tasks(CTask, CTaskSub)
+    for a_py, a_c in zip(py, c):
+        assert outcome(lambda: hash(a_c)) == outcome(lambda: hash(a_py))
+    for bad in ("text", 1.5, None):
+        t_py, t_c = PyTask(), CTask()
+        t_py._hash_value = t_c._hash_value = bad
+        assert outcome(lambda: hash(t_c)) == outcome(lambda: hash(t_py))
+
+
+def test_task_set_and_dict_order_matches_python():
+    def build(cls):
+        tasks = []
+        for n in range(2000):
+            t = cls()
+            t._hash_key = ("ebuild", "/", f"cat-{n % 37}/pkg-{n}-{n % 7}", "merge", "repo")
+            t._hash_value = hash(t._hash_key)
+            tasks.append(t)
+        return tasks
+
+    py, c = build(PyTask), build(CTask)
+    assert [t._hash_key for t in set(py)] == [t._hash_key for t in set(c)]
+    assert [t._hash_key for t in set(py[::3]) | set(py[::5])] == [
+        t._hash_key for t in set(c[::3]) | set(c[::5])
+    ]
+    d = {t: n for n, t in enumerate(c)}
+    # lookup by the bare key tuple, as depgraph._pkg() does
+    assert all(d[t._hash_key] == n for n, t in enumerate(c))
+    assert all(t._hash_key in d for t in c)
+
+
+ATOM_STRINGS = ["dev-libs/foo", "dev-libs/foo", ">=dev-libs/foo-1:0=", "", "ż/ó"]
+
+
+def make_atoms(cls):
+    atoms = []
+    for s in ATOM_STRINGS:
+        a = object.__new__(cls)
+        a._string = s
+        atoms.append(a)
+    unset = object.__new__(cls)
+    nonstr = object.__new__(cls)
+    nonstr._string = ("not", "a", "string")
+    unhashable = object.__new__(cls)
+    unhashable._string = ["list"]
+    return atoms + [unset, nonstr, unhashable]
+
+
+class StrSub(str):
+    pass
+
+
+ATOM_FOREIGN = ["dev-libs/foo", StrSub("dev-libs/foo"), "", b"dev-libs/foo", 1, None, object()]
+
+
+def test_atom_matches_python():
+    py, c = make_atoms(PyAtom), make_atoms(CAtom)
+    ops = (
+        ("eq", lambda x, y: x == y),
+        ("ne", lambda x, y: x != y),
+        ("req", lambda x, y: y == x),
+        ("rne", lambda x, y: y != x),
+        ("dunder_eq", lambda x, y: x.__eq__(y)),
+        ("dunder_ne", lambda x, y: x.__ne__(y)),
+        ("dunder_lt", lambda x, y: x.__lt__(y)),
+    )
+    for (i, a_py), (j, b_py) in itertools.product(enumerate(py), repeat=2):
+        for name, op in ops:
+            expected = outcome(lambda: op(a_py, b_py))
+            got = outcome(lambda: op(c[i], c[j]))
+            assert got == expected, (name, i, j, got, expected)
+    for i, a_py in enumerate(py):
+        for k, other in enumerate(ATOM_FOREIGN):
+            for name, op in ops:
+                expected = outcome(lambda: op(a_py, other))
+                got = outcome(lambda: op(c[i], other))
+                assert got == expected, (name, i, k, got, expected)
+        assert outcome(lambda: hash(c[i])) == outcome(lambda: hash(a_py))
+
+
+def test_atom_field():
+    a = object.__new__(CAtom)
+    assert getattr(a, "_string", None) is None
+    a._string = "x/y"
+    assert a._string == "x/y" and hash(a) == hash("x/y")
+    assert {a: 1}["x/y"] == 1  # a str finds an Atom key and the reverse
+    assert a in {"x/y"}
+
+
+def test_real_classes_use_the_c_bases():
+    from _emerge.Blocker import Blocker
+    from _emerge.Package import Package
+    from _emerge.Task import Task
+    from portage.dep import Atom
+
+    assert issubclass(Task, _hashbase.TaskBase)
+    assert issubclass(Atom, _hashbase.AtomBase)
+    for cls in (Task, Package, Blocker):
+        assert cls.__hash__ is _hashbase.TaskBase.__hash__
+        assert "__eq__" not in cls.__dict__
+    assert "_string" not in Atom.__slots__
+    a = Atom("dev-libs/foo")
+    assert a == "dev-libs/foo" and a == Atom("dev-libs/foo") and a != Atom("dev-libs/bar")
