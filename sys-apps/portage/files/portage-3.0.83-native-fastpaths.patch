+# ---- priorities ------------------------------------------------------------
+
+from portage.util import _py_cmp_sort_key  # noqa: E402
+
+FLAGS = ("optional", "buildtime_slot_op", "buildtime", "runtime_slot_op", "runtime", "runtime_post")
+
+
+def py_priority_int(p):
+    """DepPriority.__int__, the method itself."""
+    from _emerge.DepPriority import DepPriority
+
+    return DepPriority.__int__(p)
