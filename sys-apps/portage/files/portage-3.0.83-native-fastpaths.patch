+/* ------------------------------------------------------------------ */
+/* PriorityBase                                                         */
+
+/* Base of _emerge.AbstractDepPriority: its six comparisons,
+ *
+ *     def __lt__(self, other):
+ *         return self.__int__() < other
+ *
+ * and, for an instance of exactly the registered DepPriority class, the
+ * value of its __int__() read from the slots. */
+static PyTypeObject *DepPriority_Type = NULL;
+static Py_ssize_t prio_off[6] = {-1, -1, -1, -1, -1, -1};
+static const long prio_value[6] = {-5, 0, -1, -2, -3, -4};
+static const char *const prio_name[6] = {
+	"optional", "buildtime_slot_op", "buildtime",
+	"runtime_slot_op", "runtime", "runtime_post",
+};
+static PyObject *str_dunder_int = NULL;
+
+/*  def __int__(self):                               (DepPriority)
+ *      if self.optional: return -5
+ *      if self.buildtime_slot_op: return 0
+ *      if self.buildtime: return -1
+ *      if self.runtime_slot_op: return -2
+ *      if self.runtime: return -3
+ *      if self.runtime_post: return -4
+ *      return -6
+ */
+static PyObject *
+priority_int(PyObject *self)
+{
+	PyObject *flag;
+	int i, truth;
+
+	if (Py_TYPE(self) == DepPriority_Type) {
+		for (i = 0; i < 6; i++) {
+			flag = SLOT_AT(self, prio_off[i]);
+			if (flag == NULL)
+				goto python;	/* unset slot: AttributeError there */
+			if (flag == Py_True)
+				return PyLong_FromLong(prio_value[i]);
+			if (flag == Py_False || flag == Py_None)
+				continue;
+			Py_INCREF(flag);
+			truth = PyObject_IsTrue(flag);
+			Py_DECREF(flag);
+			if (truth < 0)
+				return NULL;
+			if (truth)
+				return PyLong_FromLong(prio_value[i]);
+		}
+		return PyLong_FromLong(-6);
+	}
+python:
+	return PyObject_CallMethodNoArgs(self, str_dunder_int);
+}
+
+static PyObject *
+prioritybase_richcompare(PyObject *self, PyObject *other, int op)
+{
+	PyObject *value, *res;
+
+	value = priority_int(self);
+	if (value == NULL)
+		return NULL;
+	res = PyObject_RichCompare(value, other, op);
+	Py_DECREF(value);
+	return res;
+}
+
+static PyType_Slot prioritybase_slots[] = {
+	{Py_tp_richcompare, prioritybase_richcompare},
+	{0, NULL}
+};
+
+static PyType_Spec prioritybase_spec = {
+	.name = "portage.util._hashbase.PriorityBase",
+	.basicsize = sizeof(PyObject),
+	.flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_BASETYPE,
+	.slots = prioritybase_slots,
+};
