+++ b/lib/portage/package/ebuild/config.py
@@ -146,6 +146,233 @@
             return m
 
 
+# (variable name, values, override tokens) -> the stacked flags, sorted and joined
+# Set when regenerate() prints one of its warnings about a "+" or "-" operator
+# in a value. These are printed again for every package whose settings are
+# computed, so depgraph (_probe_bounds_allowed) looks at this before it
+# passes over packages that nobody needs, in order to print as many of them
+# as it would otherwise.
+_regenerate_warned = False
+
+_regenerate_stack_incremental_memo = {}
+_REGENERATE_STACK_INCREMENTAL_MEMO_MAX = 4096
+
+
+def _regenerate_stack_incremental(mykey, incremental_list, override_tokens):
+    """
+    The loop of config.regenerate() that stacks the values of one incremental
+    variable, moved here unchanged. incremental_list holds the value of the
+    variable in each db that sets it, as an unsplit string, in stacking
+    order; override_tokens are stacked last (the FEATURES overrides).
+
+    Returns (set of flags, memoizable). The result depends on nothing but
+    the arguments; memoizable is False when a warning was printed, which a
+    memo hit would not print again.
+    """
+    global _regenerate_warned
+    myflags = set()
+    memoizable = True
+    for mysplit in chain((v.split() for v in incremental_list), (override_tokens,)):
+        for x in mysplit:
+            if x == "-*":
+                # "-*" is a special "minus" var that means "unset all settings".
+                # so USE="-* gnome" will have *just* gnome enabled.
+                myflags.clear()
+                continue
+
+            if x[0] == "+":
+                # Not legal. People assume too much. Complain.
+                memoizable = False
+                _regenerate_warned = True
+                writemsg(
+                    colorize(
+                        "BAD",
+                        _("%s values should not start with a '+': %s") % (mykey, x),
+                    )
+                    + "\n",
+                    noiselevel=-1,
+                )
+                x = x[1:]
+                if not x:
+                    continue
+
+            if x[0] == "-":
+                myflags.discard(x[1:])
+                continue
+
+            # We got here, so add it now.
+            myflags.add(x)
+
+    return myflags, memoizable
+
+
+
+# use_stack_inputs (see _regenerate_use_stack) -> frozenset of the flags.
+_regenerate_use_stack_memo = {}
+# Bounds the memory held by the memo (one set of a few hundred flags each).
+_REGENERATE_USE_STACK_MEMO_MAX = 4096
+
+
+def _regenerate_use_stack(use_stack_inputs, iuse):
+    """
+    The USE stacking loop of config.regenerate(), moved here unchanged except
+    that it works on the values that regenerate() has read from the dbs of
+    uvlist (in the same order, with the same lookups) instead of reading them
+    itself. use_stack_inputs has one item per db:
+
+        (values of the USE_EXPAND_UNPREFIXED variables (None if unset),
+         USE string,
+         names of the USE_EXPAND variables set in the db,
+         for each of these (value, "is not incremental"), or None if the
+         loop does not look at them: the defaults db, or nothing to do)
+
+    Returns (set of flags, memoizable). The result depends on nothing but the
+    arguments, and on iuse only where a flag to enable ends with "_*". So
+    when no such flag was seen and no warning was printed (a memo hit would
+    not print it again), memoizable is
+    True and regenerate() may answer a later call with equal use_stack_inputs
+    from _regenerate_use_stack_memo. setcpv() calls regenerate() for every
+    package, and most packages have the same USE inputs as an earlier one.
+    """
+    global _regenerate_warned
+    myflags = set()
+    memoizable = True
+    for unprefixed_values, use_str, cur_use_expand, expand_values in use_stack_inputs:
+        for v in unprefixed_values:
+            if v is None:
+                continue
+            for x in v.split():
+                if x[:1] == "-":
+                    myflags.discard(x[1:])
+                else:
+                    myflags.add(x)
+
+        mysplit = use_str.split()
+        if not mysplit and not cur_use_expand:
+            continue
+        for x in mysplit:
+            if x == "-*":
+                myflags.clear()
+                continue
+
+            if x[0] == "+":
+                memoizable = False
+                _regenerate_warned = True
+                writemsg(
+                    colorize(
+                        "BAD",
+                        _("USE flags should not start " "with a '+': %s\n") % x,
+                    ),
+                    noiselevel=-1,
+                )
+                x = x[1:]
+                if not x:
+                    continue
+
+            if x[0] == "-":
+                if x[-2:] == "_*":
+                    prefix = x[1:-1]
+                    prefix_len = len(prefix)
+                    myflags.difference_update(
+                        [y for y in myflags if y[:prefix_len] == prefix]
+                    )
+                myflags.discard(x[1:])
+                continue
+
+            if x[-2:] == "_*":
+                # The only place where iuse matters.
+                memoizable = False
+            if iuse is not None and x[-2:] == "_*":
+                # Expand wildcards here, so that cases like
+                # USE="linguas_* -linguas_en_US" work correctly.
+                prefix = x[:-1]
+                prefix_len = len(prefix)
+                has_iuse = False
+                for y in iuse:
+                    if y[:prefix_len] == prefix:
+                        has_iuse = True
+                        myflags.add(y)
+                if not has_iuse:
+                    # There are no matching IUSE, so allow the
+                    # wildcard to pass through. This allows
+                    # linguas_* to trigger unset LINGUAS in
+                    # cases when no linguas_ flags are in IUSE.
+                    myflags.add(x)
+            else:
+                myflags.add(x)
+
+        if expand_values is None:
+            # USE_EXPAND flags from make.defaults are handled
+            # earlier, in order to provide useful incremental
+            # behavior (for sub-profiles).
+            continue
+
+        for var, (expand_value, is_not_incremental) in zip(
+            cur_use_expand, expand_values
+        ):
+            var_lower = var.lower()
+            if is_not_incremental:
+                prefix = var_lower + "_"
+                prefix_len = len(prefix)
+                for x in list(myflags):
+                    if x[:prefix_len] == prefix:
+                        myflags.remove(x)
+            for x in expand_value.split():
+                if x[0] == "+":
+                    memoizable = False
+                    _regenerate_warned = True
+                    if is_not_incremental:
+                        writemsg(
+                            colorize(
+                                "BAD",
+                                _(
+                                    "Invalid '+' "
+                                    "operator in non-incremental variable "
+                                    "'%s': '%s'\n"
+                                )
+                                % (var, x),
+                            ),
+                            noiselevel=-1,
+                        )
+                        continue
+                    else:
+                        writemsg(
+                            colorize(
+                                "BAD",
+                                _(
+                                    "Invalid '+' "
+                                    "operator in incremental variable "
+                                    "'%s': '%s'\n"
+                                )
+                                % (var, x),
+                            ),
+                            noiselevel=-1,
+                        )
+                    x = x[1:]
+                if x[0] == "-":
+                    if is_not_incremental:
+                        memoizable = False
+                        _regenerate_warned = True
+                        writemsg(
+                            colorize(
+                                "BAD",
+                                _(
+                                    "Invalid '-' "
+                                    "operator in non-incremental variable "
+                                    "'%s': '%s'\n"
+                                )
+                                % (var, x),
+                            ),
+                            noiselevel=-1,
+                        )
+                        continue
+                    myflags.discard(var_lower + "_" + x[1:])
+                    continue
+                myflags.add(var_lower + "_" + x)
+
+    return myflags, memoizable
+
