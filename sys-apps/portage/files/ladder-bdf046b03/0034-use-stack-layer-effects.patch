+# stage4: item of use_stack_inputs -> its effect, see _use_stack_layer_effect().
+_use_stack_layer_effect_memo = {}
+_USE_STACK_LAYER_MEMO_MAX = 4096
+
+
+def _use_stack_layer_effect(layer):
+    """
+    stage4: what the loop body of _regenerate_use_stack() does to the set
+    of flags for one item of use_stack_inputs, as a tuple
+    (clear, discards, strips, adds), or None if the loop itself has to run
+    for this item: it holds a token that makes the loop print a warning or
+    look at IUSE ("+flag", a "prefix_*" to enable, "-value" in a
+    non-incremental USE_EXPAND variable).
+
+    Without such a token the loop is a sequence of four kinds of steps:
+    add one flag, discard one flag, discard every flag with a given prefix
+    ("-prefix_*" and the reset of a non-incremental USE_EXPAND variable),
+    and clear ("-*"). Each of them treats every flag independently of the
+    other flags. So a flag is in the result if it is in the result that the
+    loop computes from the empty set (adds: it was added and not removed
+    afterwards), or if it was there at the start and no step removes it: no
+    clear, no discard of it (discards), no prefix that it starts with
+    (strips). A flag that some step removes is in the result only if a
+    later step adds it again, and then it is in adds. adds is computed by
+    the loop itself.
+    """
+    unprefixed_values, use_str, cur_use_expand, expand_values = layer
+    clear = False
+    discards = set()
+    strips = []
+    for v in unprefixed_values:
+        if v is None:
+            continue
+        for x in v.split():
+            if x[:1] == "-":
+                discards.add(x[1:])
+    mysplit = use_str.split()
+    if mysplit or cur_use_expand:
+        for x in mysplit:
+            if x == "-*":
+                clear = True
+            elif x[0] == "+":
+                return None
+            elif x[0] == "-":
+                if x[-2:] == "_*":
+                    strips.append(x[1:-1])
+                discards.add(x[1:])
+            elif x[-2:] == "_*":
+                return None
+        if expand_values is not None:
+            for var, (expand_value, is_not_incremental) in zip(
+                cur_use_expand, expand_values
+            ):
+                var_lower = var.lower()
+                if is_not_incremental:
+                    strips.append(var_lower + "_")
+                for x in expand_value.split():
+                    if x[0] == "+":
+                        return None
+                    if x[0] == "-":
+                        if is_not_incremental:
+                            return None
+                        discards.add(var_lower + "_" + x[1:])
+    adds, memoizable = _regenerate_use_stack((layer,), None)
+    if not memoizable:
+        # Not expected: the tokens that clear this flag were excluded above.
+        return None
+    return (clear, frozenset(discards), tuple(strips), frozenset(adds))
+
+
+def _regenerate_use_stack_fast(use_stack_inputs, iuse):
+    """
+    stage4: returns what _regenerate_use_stack(use_stack_inputs, iuse)
+    returns (an equal set of flags; both callers sort it). The loop of that
+    function handles one db after the other and carries nothing from one to
+    the next but the set of flags (and the memoizable flag, which only a
+    token that _use_stack_layer_effect() refuses can clear), so here each
+    db is either applied through its remembered effect or handed, alone and
+    with the flags so far, to that loop. The db of make.conf is the same
+    for every package and was the bulk of the work: about 260 tokens and
+    nine USE_EXPAND resets, for every new combination of IUSE defaults and
+    package.use (several hundred per resolve).
+    """
+    myflags = set()
+    memoizable = True
+    memo = _use_stack_layer_effect_memo
+    for layer in use_stack_inputs:
+        try:
+            effect = memo[layer]
+        except KeyError:
+            effect = _use_stack_layer_effect(layer)
+            if len(memo) < _USE_STACK_LAYER_MEMO_MAX:
+                memo[layer] = effect
+        if effect is None:
+            myflags, layer_memoizable = _regenerate_use_stack((layer,), iuse, myflags)
+            if not layer_memoizable:
+                memoizable = False
+            continue
+        clear, discards, strips, adds = effect
+        if clear:
+            myflags = set(adds)
+            continue
+        if discards:
+            myflags.difference_update(discards)
+        if strips:
+            myflags = {x for x in myflags if not x.startswith(strips)}
+        myflags.update(adds)
+    return myflags, memoizable
+
