@@ -0,0 +1,118 @@
+# stage5: the lock-step check of depgraph._AttemptMemo. Only imported when
+# depgraph._verify_attempt_memo is set; never used by a normal run.
+#
+# attempt_memo_diff() walks two depgraphs side by side (every attribute of
+# the depgraph, its _dynamic_config and _rebuild and everything reachable
+# from them: the digraph with its edge priorities, the package tracker, the
+# parent atoms, the slot operator deps, the blockers, the backtrack infos,
+# the serialized merge list, the scheduler graph, the depth of every Package)
+# and returns the paths at which they differ. Containers are compared in
+# iteration order, so a different order of a dict, a list or a set is a
+# difference too.
+
+import types
+from collections import deque
+
+from _emerge.Package import Package
+
+# Memo tables: they hold answers to pure questions, and which questions were
+# asked differs because the reused depgraph also answered the ones of
+# need_config_change() and of the prune_rebuilds condition before its restart.
+_MEMO_ATTRS = frozenset(
+    [
+        # PackageTracker.match() cache
+        "_match_cache",
+        # depgraph._slot_operator_check_reverse_dependencies lru_cache etc.
+        "_slot_operator_check_reverse_dependencies",
+    ]
+)
+
+_ATOMIC = (str, bytes, int, float, bool, type(None), type, types.ModuleType)
+_SKIP = (
+    types.FunctionType,
+    types.MethodType,
+    types.BuiltinFunctionType,
+    types.GeneratorType,
+)
+
+
+def _attrs(obj):
+    names = []
+    for cls in type(obj).__mro__:
+        slots = cls.__dict__.get("__slots__", ())
+        if isinstance(slots, str):
+            slots = (slots,)
+        names.extend(s for s in slots if s not in ("__dict__", "__weakref__"))
+    d = getattr(obj, "__dict__", None)
+    if d is not None:
+        names.extend(d)
+    return names
+
+
+def attempt_memo_diff(a, b, limit=20, memo_attrs=_MEMO_ATTRS, stats=None):
+    """
+    @return: list of "path: what" strings, empty when a and b are equal
+    """
+    diffs = []
+    seen = {}
+    stack = [(a, b, "depgraph")]
+    count = 0
+    while stack and len(diffs) < limit:
+        x, y, path = stack.pop()
+        if x is y:
+            continue
+        count += 1
+        if type(x) is not type(y):
+            diffs.append(f"{path}: type {type(x).__name__} / {type(y).__name__}")
+            continue
+        if isinstance(x, Package):
+            # Same instance in both (the package cache is shared) unless it was
+            # made by one of the two attempts.
+            if x != y or x.depth != y.depth or x.operation != y.operation:
+                diffs.append(f"{path}: package {x} / {y}")
+            continue
+        if isinstance(x, _ATOMIC):
+            if x != y:
+                diffs.append(f"{path}: {x!r:.80} / {y!r:.80}")
+            continue
+        if isinstance(x, _SKIP) or hasattr(x, "cache_info"):
+            continue
+        if id(x) in seen:
+            if seen[id(x)] != id(y):
+                diffs.append(f"{path}: shared object paired with two objects")
+            continue
+        seen[id(x)] = id(y)
+        if isinstance(x, dict):
+            if len(x) != len(y):
+                diffs.append(f"{path}: dict size {len(x)} / {len(y)}")
+                continue
+            for i, ((k1, v1), (k2, v2)) in enumerate(zip(x.items(), y.items())):
+                stack.append((k1, k2, f"{path}.key{i}"))
+                stack.append((v1, v2, f"{path}[{k1!s:.60}]"))
+        elif isinstance(x, (list, tuple, deque, set, frozenset)):
+            if len(x) != len(y):
+                diffs.append(f"{path}: size {len(x)} / {len(y)}")
+                continue
+            for i, (v1, v2) in enumerate(zip(x, y)):
+                stack.append((v1, v2, f"{path}[{i}]"))
+        else:
+            names = _attrs(x)
+            if not names and not hasattr(x, "__dict__"):
+                if x != y:
+                    diffs.append(f"{path}: {x!r:.80} / {y!r:.80}")
+                continue
+            for name in names:
+                if name in memo_attrs:
+                    continue
+                try:
+                    v1 = getattr(x, name)
+                except AttributeError:
+                    v1 = _attrs
+                try:
+                    v2 = getattr(y, name)
+                except AttributeError:
+                    v2 = _attrs
+                stack.append((v1, v2, f"{path}.{name}"))
+    if stats is not None:
+        stats["objects"] = stats.get("objects", 0) + count
+    return diffs
