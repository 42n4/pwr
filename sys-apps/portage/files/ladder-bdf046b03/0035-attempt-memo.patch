+class AttemptMemoTestCase(TestCase):
+    def _verified(self):
+        return depgraph_module._attempt_memo_verified.get("attempts", 0)
+
+    def _run(self, case, name):
+        """
+        Run another test case with _verify_attempt_memo: every attempt that
+        the memo would hand out is also built from nothing and compared with
+        it (AssertionError on a difference), and at least one must occur.
+        """
+        before = self._verified()
+        with patch.object(depgraph_module, "_verify_attempt_memo", True):
+            getattr(case(name), name)()
+        self.assertGreater(self._verified(), before)
+
+        # And the plain runs, with and without the memo, pass the case's own
+        # checks.
+        getattr(case(name), name)()
+        with patch.object(depgraph_module, "_attempt_memo_enabled", False):
+            getattr(case(name), name)()
+
+    def testSlotOperatorCompleteGraph(self):
+        self._run(
+            _complete_graph.SlotOperatorCompleteGraphTestCase,
+            "testSlotOperatorCompleteGraph",
+        )
