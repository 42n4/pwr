+# stage5: switches of _AttemptMemo. With _verify_attempt_memo every reused
+# attempt is also built from nothing, the two depgraphs are compared
+# (_attempt_memo_verify) and an AssertionError is raised when they differ;
+# the run then goes on with the one built from nothing.
+_attempt_memo_enabled = True
+# PORTAGE_STAGE5_VERIFY=1 (or "memo") in the environment turns it on. Unset in
+# normal use.
+_verify_attempt_memo = os.environ.get("PORTAGE_STAGE5_VERIFY") in ("1", "memo")
+# Depgraphs of failed attempts kept at most (each holds a whole graph).
+_ATTEMPT_MEMO_SIZE = 8
+
+
+def _attempt_param_image(obj):
+    """
+    stage5: an image of a backtrack parameter value that compares equal only
+    when the contents AND the iteration order are equal (and, for sets, the
+    size of the hash table), since the resolver iterates over these containers.
+    """
+    if isinstance(obj, dict):
+        return [(k, _attempt_param_image(v)) for k, v in obj.items()]
+    if isinstance(obj, (set, frozenset)):
+        return (sys.getsizeof(obj), [_attempt_param_image(x) for x in obj])
+    if isinstance(obj, (list, tuple)):
+        return [_attempt_param_image(x) for x in obj]
+    return obj
+
+
+class _AttemptMemo:
+    """
+    stage5: reuse of whole backtracking attempts.
+
+    The Backtracker never hands out two equal parameter sets, but after a
+    prune_rebuilds restart it hands out parameter sets that differ from an
+    earlier one in nothing except prune_rebuilds=True. That flag is read at
+    exactly one place, _resolve_after_prune_check(), after the graph is
+    built, the conflicts are processed and the merge list is serialized. So
+    for backtrack parameters that equal those of an earlier attempt E in
+    everything else (contents and iteration order), a new depgraph would
+    repeat E step by step up to that check, and then:
+
+    * E returned before the check, or its condition was false: the flag is
+      never looked at or makes no difference, the new attempt IS E. E is
+      handed out again as it is.
+    * E restarted there for prune_rebuilds: the new attempt skips the
+      condition and goes on. E is put back to the state before the check
+      and runs the rest of _resolve() (_resume_with_prune_rebuilds).
+
+    "Equal" leaves out the order of the packages in runtime_pkg_mask, see
+    image().
+
+    Package instances are shared by all attempts and _add_pkg() writes their
+    depth; the attempts between E and now may have changed it, so the depths
+    E assigned (the same ones the new attempt would assign) are written
+    again. Only attempts with prune_rebuilds=False are kept, only the last
+    _ATTEMPT_MEMO_SIZE of them, and an entry is used once.
+    """
+
+    __slots__ = ("_entries",)
+
+    def __init__(self):
+        self._entries = []
+
+    @staticmethod
+    def image(backtrack_parameters):
+        image = [
+            _attempt_param_image(getattr(backtrack_parameters, k))
+            for k in BacktrackParameter.__slots__
+            if k not in ("prune_rebuilds", "runtime_pkg_mask")
+        ]
+        # The order of the packages in runtime_pkg_mask is left out: a
+        # prune_rebuilds restart takes the slot_operator_mask_built entries
+        # out and later attempts put them back at the end. The resolver looks
+        # packages up in this dict and iterates over it at two places, both
+        # independent of the order as far as an attempt's course goes
+        # (_add_dep: "is there an entry that ...", _get_missed_updates: one
+        # result per slot, of which _resolve only asks whether there is any).
+        # The order of the result of _get_missed_updates is the order of the
+        # display, so reuse() hands the new dict to the reused depgraph.
+        image.append(
+            {
+                pkg: _attempt_param_image(reasons)
+                for pkg, reasons in backtrack_parameters.runtime_pkg_mask.items()
+            }
+        )
+        return image
+
+    def store(self, image, mydepgraph, success, favorites):
+        self._entries.append((image, mydepgraph, success, favorites))
+        if len(self._entries) > _ATTEMPT_MEMO_SIZE:
+            del self._entries[0]
+
+    def reuse(self, image, backtrack_parameters):
+        """
+        @param image: image(backtrack_parameters), taken before any depgraph
+                got these parameters
+        @return: (depgraph, success, favorites) of the attempt for these
+                parameters (prune_rebuilds=True), or None when no kept
+                attempt has them.
+        """
+        for i, entry in enumerate(self._entries):
+            if entry[0] == image:
+                break
+        else:
+            return None
+        del self._entries[i]
+        image, mydepgraph, success, favorites = entry
+        dynamic_config = mydepgraph._dynamic_config
+        for pkg, depth in dynamic_config._attempt_depths.items():
+            pkg.depth = depth
+        # Equal to the old one but for the order; the depgraph only reads it.
+        dynamic_config._runtime_pkg_mask = backtrack_parameters.runtime_pkg_mask
+        # select_files() leaves this None; need_config_change() of the first
+        # use may have built one, and builds the same one again.
+        dynamic_config._slot_conflict_handler = None
+        if dynamic_config._attempt_checkpoint is None:
+            dynamic_config._prune_rebuilds = True
+        else:
+            success, favorites = mydepgraph._resume_with_prune_rebuilds(favorites)
+        return mydepgraph, success, favorites
+
+
+def _attempt_memo_verify(reused, built):
+    """
+    stage5: the check behind _verify_attempt_memo.
+    """
+    from _emerge._attempt_memo_verify import attempt_memo_diff
+
+    if reused is None:
+        return
+    diffs = []
+    # A merge list that altlist() put off in both (the merge order deferral of
+    # _stage5_serialize_skippable, where this build has it) is computed now,
+    # so that the lists and the scheduler graphs are compared as well.
+    for attempt in (reused, built):
+        finish = getattr(attempt[0], "_stage5_finish_serialize", None)
+        if finish is not None:
+            finish()
+    if bool(reused[1]) != bool(built[1]):
+        diffs.append(f"success: {reused[1]} / {built[1]}")
+    if list(reused[2]) != list(built[2]):
+        diffs.append("favorites differ")
+    diffs.extend(attempt_memo_diff(reused[0], built[0], stats=_attempt_memo_verified))
+    # The depths that reuse() wrote are those the rebuilt attempt left behind.
+    for pkg, depth in built[0]._dynamic_config._attempt_depths.items():
+        if pkg.depth != depth:
+            diffs.append(f"depth of {pkg}: {pkg.depth} / {depth}")
+            break
+    _attempt_memo_verified["attempts"] = _attempt_memo_verified.get("attempts", 0) + 1
+    if diffs:
+        raise AssertionError(
+            "_AttemptMemo: reused attempt differs from the rebuilt one:\n  "
+            + "\n  ".join(diffs)
+        )
+
+
+_attempt_memo_verified = {}
