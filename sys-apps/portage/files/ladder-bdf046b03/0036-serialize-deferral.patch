+
+# The lock-step check of the merge order deferral
+# (_emerge.depgraph.depgraph._stage5_serialize_skippable) on resolver test
+# cases that backtrack: every calculation that would be put off is carried out
+# on the spot and must end as predicted, and the list computed later must
+# equal the one computed on the spot.
+
+from unittest.mock import patch
+
+import _emerge.depgraph as depgraph_module
+from portage.tests import TestCase
+from portage.tests.resolver import test_slot_operator_complete_graph as _complete_graph
+from portage.tests.resolver import test_slot_operator_missed_update as _missed_update
+from portage.tests.resolver import (
+    test_slot_operator_runtime_pkg_mask as _runtime_pkg_mask,
+)
+
+
+class SerializeDeferralTestCase(TestCase):
+    def _run(self, case, name):
+        verified = depgraph_module._stage5_serialize_skip_verified
+        before = sum(verified.values())
+        with patch.object(depgraph_module, "_stage5_verify_serialize_skip", True):
+            getattr(case(name), name)()
+        self.assertGreater(sum(verified.values()), before)
+
+        if hasattr(depgraph_module, "_verify_attempt_memo"):
+            # With the reuse of whole backtracking attempts in the same build:
+            # a reused attempt then carries a list that was put off, and the
+            # comparison of the two depgraphs covers both lists.
+            before = sum(verified.values())
+            with patch.object(
+                depgraph_module, "_verify_attempt_memo", True
+            ), patch.object(depgraph_module, "_stage5_verify_serialize_skip", True):
+                getattr(case(name), name)()
+            self.assertGreater(sum(verified.values()), before)
+
+        # The plain run passes the case's own checks.
+        getattr(case(name), name)()
+
+    def testSlotOperatorCompleteGraph(self):
+        self._run(
+            _complete_graph.SlotOperatorCompleteGraphTestCase,
+            "testSlotOperatorCompleteGraph",
+        )
+
+    def testBacktrackMissedUpdate(self):
+        self._run(
+            _missed_update.BacktrackMissedUpdateTestCase,
+            "testBacktrackMissedUpdateTestCase",
+        )
+
+    def testSlotOperatorRuntimePkgMask(self):
+        self._run(
+            _runtime_pkg_mask.SlotOperatorRuntimePkgMaskTestCase,
+            "testSlotOperatorRuntimePkgMask",
+        )
