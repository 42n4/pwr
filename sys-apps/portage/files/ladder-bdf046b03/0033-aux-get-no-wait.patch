+    def _aux_get_no_wait(self, mycpv, mylist, mytree, myrepo):
+        """
+        stage4: what async_aux_get() returns when it has nothing to wait
+        for, i.e. when the answer is in self._aux_cache or the ebuild has a
+        valid metadata cache entry; None in every other case (unknown
+        repository, malformed cpv, ebuild not found, no valid cache entry),
+        and then aux_get() runs async_aux_get() as before, which reports
+        the problem or runs the metadata phase. These are the statements
+        of async_aux_get() up to its first await, in the same order, so the
+        same values are returned, the same entry is stored in
+        self._aux_cache and the same exception leaves _pull_valid_cache()
+        for an ebuild file that has vanished. A coroutine that ends without
+        awaiting gains nothing from an event loop, but run_until_complete()
+        costs a task and two passes of the loop per call, and a resolve
+        makes several thousand of these calls, one per ebuild it looks at.
+        After a None, async_aux_get() repeats findname2() and
+        _pull_valid_cache(); they answer the same again.
+        """
+        cache_me = False
+        if myrepo is not None:
+            mytree = self.treemap.get(myrepo)
+            if mytree is None:
+                return None
