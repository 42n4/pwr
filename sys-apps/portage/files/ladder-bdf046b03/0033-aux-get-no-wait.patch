+            return None
+
+        mydata, ebuild_hash = self._pull_valid_cache(mycpv, myebuild, mylocation)
+        if mydata is None:
+            return None
+
+        return self._aux_get_return(
+            mycpv,
+            mylist,
+            myebuild,
+            ebuild_hash,
+            mydata,
+            mylocation,
+            cache_me,
+        )
