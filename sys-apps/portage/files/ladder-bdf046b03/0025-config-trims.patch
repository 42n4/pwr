diff -ruN a/lib/portage/package/ebuild/_config/UseManager.py b/lib/portage/package/ebuild/_config/UseManager.py
--- a/lib/portage/package/ebuild/_config/UseManager.py
+++ b/lib/portage/package/ebuild/_config/UseManager.py
@@ -31,6 +31,34 @@
 from portage.versions import _pkg_str
 
 
+# tuple of the stacked token tuples -> frozenset of the stacked result
+_stack_use_lists_memo = {}
+_STACK_USE_LISTS_MEMO_MAX = 4096
+
+
+def _stack_use_lists(lists):
+    """
+    Return frozenset(stack_lists(lists, incremental=True)) for the lists of
+    USE flag strings that getUseMask() and getUseForce() collect. With these
+    arguments stack_lists is a pure function of the token sequences (it
+    prints nothing and reads nothing else), the tokens are plain strings and
+    the result is immutable, so the result for an equal argument is reused.
+    Nearly all packages collect the same lists (those of the profiles).
+    """
+    try:
+        key = tuple([x if x.__class__ is tuple else tuple(x) for x in lists])
+        return _stack_use_lists_memo[key]
+    except KeyError:
+        pass
+    except TypeError:
+        # Unhashable token: not memoized.
+        return frozenset(stack_lists(lists, incremental=True))
+    result = frozenset(stack_lists(lists, incremental=True))
+    if len(_stack_use_lists_memo) < _STACK_USE_LISTS_MEMO_MAX:
+        _stack_use_lists_memo[key] = result
+    return result
+
+
