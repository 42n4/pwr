+    def _pkg_use_make_template(self):
+        """
+        Called at the very end of a complete setcpv() call for a Package
+        (built or not: what is recorded here does not depend on the
+        package). Returns what _pkg_use_fast() needs to know about the state
+        that this call left behind, or None if _pkg_use_fast() must not be
+        used after this call.
+        """
+        last = self._regenerate_last
+        configdict = self.configdict
+        env = configdict["env"]
+        if (
+            last is None
+            # regenerate() printed a warning: every setcpv() call prints it.
+            or not last[1]
+            # package.env settings of this package are in effect, some of
+            # them in objects shared with other config instances.
+            or self._penv
+            # make.defaults of this package's repository are in effect.
+            or configdict["repo"]
+            # FEATURES=test makes USE depend on RESTRICT and PROPERTIES.
+            or "test" in self.features
+            or configdict["features"].get("USE") != ""
+            or self.configlist[-1] is not env
+            or self.lookuplist[0] is not env
+            or len(self.uvlist) != len(last[0])
+        ):
+            return None
+        use_stack_inputs = last[0]
+        use_expand = self.get("USE_EXPAND", "")
+        use_expand_hidden = self.get("USE_EXPAND_HIDDEN", "")
+        # No variable that setcpv() and regenerate() look up for the USE
+        # calculation may be a key of the "pkg" dict, which differs from
+        # package to package ("USE" itself is handled explicitly).
+        names = set(self.incrementals)
+        names.update(use_expand.split())
+        names.update(self.get("USE_EXPAND_UNPREFIXED", "").split())
+        names.update(_PKG_USE_FAST_LOOKUPS)
+        names.discard("USE")
+        if not names.isdisjoint(self._setcpv_aux_keys) or not names.isdisjoint(
+            _PKG_USE_FAST_PKG_KEYS
+        ):
+            return None
+        index = {}
+        for i, curdb in enumerate(self.uvlist):
+            for name in ("pkg", "defaults", "pkginternal"):
+                if curdb is configdict[name]:
+                    index[name] = i
+        for name in ("pkg", "pkginternal"):
+            i = index.get(name)
+            if i is not None:
+                unprefixed_values, _use_str, cur_use_expand, _ = use_stack_inputs[i]
+                if cur_use_expand or any(v is not None for v in unprefixed_values):
+                    return None
+        return (
+            use_stack_inputs,
+            index.get("pkg"),
+            index.get("defaults"),
+            index.get("pkginternal"),
+            use_expand,
+            use_expand_hidden,
+        )
+
+    def _pkg_use_fast(self, pkg):
+        """
+        For an unbuilt Package: return what the resolver reads from this
+        instance right after setcpv(pkg), namely
+
+            (self["PORTAGE_USE"], self.get("USE_EXPAND", ""),
+             self.get("USE_EXPAND_HIDDEN", ""), self.useforce, self.usemask)
+
+        without calling setcpv(pkg), or return None if the caller has to call
+        setcpv(pkg). This instance is left exactly as the last complete
+        setcpv() call left it, except that _setcpv_args_hash is cleared.
+
+        Why the values are those of setcpv(pkg):
+
+        A setcpv() call that reaches reset() computes values that do not
+        depend on the package of the call before, except through
+        package.env settings, repository make.defaults and FEATURES=test.
+        Since upstream commit 64701b0a3 (after 3.0.83, where a defective
+        chained comparison made every call reach reset()), setcpv() returns
+        early when none of the inputs that it compares differs from the
+        previous package; it then keeps the values computed for that
+        package, which are the values that a complete call computes from
+        the same inputs. Such a call ends before the template is made, so
+        after it there is no template until the next complete call (it was
+        dropped by modifying() at the start), and this method returns None.
+        A template exists only if the last
+        complete setcpv() call had none of the three (see
+        _pkg_use_make_template), and it is dropped by modifying(), that is by
+        anything that changes this instance. With a template, the values
+        that regenerate() reads from the dbs of USE_ORDER differ from those
+        it read in that last call only in the USE strings of the "pkg",
+        "defaults" and "pkginternal" dicts. This method computes these three
+        strings, useforce, usemask and "stable" with the statements of
+        setcpv(), returns None for any package that has package.env or
+        repository settings, and stacks with the same _regenerate_use_stack()
+        (and the same memo) as regenerate(). The filtering by IUSE that
+        follows in setcpv() is repeated here for the case without "_*"
+        wildcards; None is returned in the other case.
+
+        Clearing _setcpv_args_hash keeps the next setcpv() call from
+        returning early for a package that this method was not called for
+        last (the hash contains id(pkg), which could be reused).
+        """
+        template = self._pkg_use_template
+        if template is None or self.locked or pkg.built:
+            return None
+        if pkg.cycle_use_changes:
+            # A transient instance of --cycle-break (upstream, after
+            # 3.0.83): setcpv() adds its forced flags to the USE of the
+            # "pkg" dict (_cycle_use_str). Left to setcpv().
+            return None
+        mydb = pkg._metadata
+        if "EAPI" not in mydb or "IUSE" not in mydb:
+            return None
+        if not _get_eapi_attrs(mydb["EAPI"]).iuse_effective:
+            return None
+        iuse = mydb["IUSE"]
+        repository = mydb["repository"] if "repository" in mydb else None
+        cp = cpv_getkey(pkg.cpv)
+        use_manager = self._use_manager
+
+        pkginternaluse_list = []
+        for x in iuse.split():
+            if x.startswith("+"):
+                pkginternaluse_list.append(x[1:])
+            elif x.startswith("-"):
+                pkginternaluse_list.append(x)
+        pkginternaluse = " ".join(pkginternaluse_list)
+
+        stable = self._isStable(pkg)
+
+        if repository and repository != Package.UNKNOWN_REPO:
+            repos = []
+            try:
+                repos.extend(
+                    repo.name for repo in self.repositories[repository].masters
+                )
+            except KeyError:
+                pass
+            repos.append(repository)
+            for repo in repos:
+                # Anything that could put an entry into setcpv()'s repo_env.
+                if (
+                    self._repo_make_defaults.get(repo)
+                    or (stable and use_manager._repo_use_stable_dict.get(repo, ()))
+                    or use_manager._repo_puse_dict.get(repo, {}).get(cp)
+                    or (
+                        stable
+                        and use_manager._repo_puse_stable_dict.get(repo, {}).get(cp)
+                    )
+                ):
+                    return None
+
+        defaults = []
+        for i, pkgprofileuse_dict in enumerate(use_manager._pkgprofileuse):
+            if self.make_defaults_use[i]:
+                defaults.append(self.make_defaults_use[i])
+
+            # package.use.stable > package.use > use.stable
+            if stable and use_manager._use_stable_list[i]:
+                defaults.append(" ".join(use_manager._use_stable_list[i]))
+
+            cpdict = pkgprofileuse_dict.get(cp)
+            if cpdict:
+                pkg_defaults = ordered_by_atom_specificity(cpdict, pkg)
+                if pkg_defaults:
+                    defaults.extend(pkg_defaults)
+
+            if stable:
+                cpdict = use_manager._puse_stable_list[i].get(cp)
+                if cpdict:
+                    pkg_defaults = ordered_by_atom_specificity(cpdict, pkg)
+                    if pkg_defaults:
+                        defaults.extend(pkg_defaults)
+
+        defaults = " ".join(defaults)
+
+        useforce = use_manager.getUseForce(pkg)
+        usemask = use_manager.getUseMask(pkg)
+        puse = use_manager.getPUSE(pkg)
+
+        cpdict = self._penvdict.get(cp)
+        if cpdict and ordered_by_atom_specificity(cpdict, pkg):
+            return None
+
+        # A token that makes _regenerate_use_stack() print a warning (which
+        # setcpv() would then print as well) or look at IUSE.
+        for use_str in (puse, defaults, pkginternaluse):
+            clean = _pkg_use_fast_clean_memo.get(use_str)
+            if clean is None:
+                clean = True
+                for x in use_str.split():
+                    if x[0] == "+" or (x[0] != "-" and x[-2:] == "_*"):
+                        clean = False
+                        break
+                if len(_pkg_use_fast_clean_memo) < _PKG_USE_FAST_MEMO_MAX:
+                    _pkg_use_fast_clean_memo[use_str] = clean
+            if not clean:
+                return None
+
+        (
+            use_stack_inputs,
+            pkg_index,
+            defaults_index,
+            pkginternal_index,
+            use_expand,
+            use_expand_hidden,
+        ) = template
+        # The items that regenerate() would read from the three dicts: the
+        # "pkg" and "pkginternal" dicts set no variable of USE_EXPAND or
+        # USE_EXPAND_UNPREFIXED (checked for the template).
+        use_stack_inputs = list(use_stack_inputs)
+        if pkg_index is not None:
+            use_stack_inputs[pkg_index] = (
+                use_stack_inputs[pkg_index][0],
+                puse,
+                (),
+                () if puse.split() else None,
+            )
+        if defaults_index is not None:
+            item = use_stack_inputs[defaults_index]
+            use_stack_inputs[defaults_index] = (item[0], defaults, item[2], None)
+        if pkginternal_index is not None:
+            use_stack_inputs[pkginternal_index] = (
+                use_stack_inputs[pkginternal_index][0],
+                pkginternaluse,
+                (),
+                () if pkginternaluse.split() else None,
+            )
+        use_stack_inputs = tuple(use_stack_inputs)
+
+        arch = self.configdict["defaults"].get("ARCH")
+        iuse_effective = self._iuse_effective
+        base_key = (use_stack_inputs, useforce, usemask, arch, iuse_effective)
+        base = _pkg_use_fast_base_memo.get(base_key)
+        if base is None:
+            myflags = _regenerate_use_stack_memo.get(use_stack_inputs)
+            if myflags is not None:
+                myflags = set(myflags)
+            else:
+                myflags, memoizable = _regenerate_use_stack(
+                    use_stack_inputs, [x.lstrip("+-") for x in iuse.split()]
+                )
+                if (
+                    memoizable
+                    and len(_regenerate_use_stack_memo)
+                    < _REGENERATE_USE_STACK_MEMO_MAX
+                ):
+                    _regenerate_use_stack_memo[use_stack_inputs] = frozenset(myflags)
+            # The end of regenerate() ...
+            myflags.update(useforce)
+            if arch:
+                myflags.add(arch)
+            myflags.difference_update(usemask)
+            # ... and what setcpv() reads back from it as self["USE"].
+            use = frozenset(" ".join(sorted(myflags)).split())
+            has_wildcard = False
+            for x in use:
+                if x[-2:] == "_*":
+                    has_wildcard = True
+                    break
+            # (flags that pass the IUSE filter whatever the package is,
+            #  USE as a whole, whether setcpv() has wildcards to expand)
+            base = (use.intersection(iuse_effective), use, has_wildcard)
+            if len(_pkg_use_fast_base_memo) < _PKG_USE_FAST_MEMO_MAX:
+                _pkg_use_fast_base_memo[base_key] = base
+        if base[2]:
+            return None
+
+        # setcpv() keeps the flags x of USE with
+        # "x in explicit_iuse or iuse_implicit_match(x)" (no "_*" here), and
+        # iuse_implicit_match is _iuse_effective_match for this EAPI.
+        portage_use = " ".join(sorted(base[0].union(base[1].intersection(pkg.iuse.all))))
+
+        result = (portage_use, use_expand, use_expand_hidden, useforce, usemask)
+        if _PKG_USE_FAST_SELFTEST is not None:
+            _PKG_USE_FAST_SELFTEST(self, pkg, result)
+        else:
+            self._setcpv_args_hash = None
+        return result
+
     def _read_pkg_env(self, penv, abs_user_config):
         """
         Return (path, settings) pairs for the env files named by penv.
