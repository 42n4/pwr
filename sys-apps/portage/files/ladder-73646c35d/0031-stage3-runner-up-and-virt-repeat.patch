+def _pkgset_inert(pkgset):
+    """
+    stage4 (from the stage 3 candidate r03-c1): True if
+    pkgset.findAtomForPackage(pkg, modified_use=use) returns None for every
+    package and does nothing else: pkgset is a plain InternalPackageSet or
+    WildcardPackageSet that is loaded, so that _load() does nothing, and it
+    has no atom at all, which makes the first shortcut of
+    PackageSet.findAtomForPackage() return None whatever the cp of pkg is.
+    What that method does before (a copy of pkg with the modified USE,
+    cpv_getkey) has no effect outside of it. This is the state of the sets
+    of --exclude, --reinstall-atoms and --useoldpkg-atoms unless the option
+    is given, and the resolver consults them for every package it examines.
+
+    A caller that skips the call still has to do what evaluating the
+    argument self._pkg_use_enabled(pkg) and the method's own read of
+    pkg.use do besides returning a value: pkg.use is computed if that has
+    not been done yet.
+    """
