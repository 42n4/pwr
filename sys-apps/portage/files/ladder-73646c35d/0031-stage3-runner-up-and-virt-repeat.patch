+        pkgset.__class__ is not InternalPackageSet
+    ):
+        return False
+    atommap = pkgset._atommap
+    return (
+        pkgset._loaded
+        and atommap.__class__ is ExtendedAtomDict
+        and not atommap._extended
+        and not atommap._normal
+    )
