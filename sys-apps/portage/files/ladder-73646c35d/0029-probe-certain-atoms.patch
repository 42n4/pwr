+    def _select_atoms_probe_certain(self, root, pkg):
+        """
+        A frozenset of atoms that are certain to be in the result of
+        _select_atoms_probe(root, pkg), found without dep_check(): the
+        unevaluated form of every atom that stands at the top level of one
+        of the dependency lists that _select_atoms_probe_imp() hands to
+        dep_check() (use_reduce() of a dependency string with the USE of
+        pkg), i.e. outside every "||" group, and that is an instance of
+        exactly Atom, not for a virtual/ package and not for a package that
+        package.provided names.
+
+        dep_check() cannot drop such an atom: _expand_new_virtuals() copies
+        it and adds it to atom_graph as a child of the parent,
+        _overlap_dnf() passes on what is not a "||" group, dep_wordreduce()
+        (no dbapi, not in package.provided) marks it as not satisfied, and
+        dep_zapdeps() returns every top level atom that is not satisfied;
+        _select_atoms_highest_available() then lists it under the parent,
+        as a child of the parent in atom_graph that dep_check() returned.
+        Most slot operator dependencies are of this kind, so the probe,
+        which runs dep_check() on every dependency string of the package,
+        is rarely needed for them.
+
+        The set is empty where this reasoning does not hold: with
+        --ignore-built-slot-operator-deps (the atoms of a built package are
+        rewritten before dep_check), without local_config, while a virtual
+        is being expanded (virt_parent), when a dependency string is
+        invalid, and once config.regenerate() has printed a warning (see
+        _probe_bounds_allowed; dep_check can create packages). It is also
+        empty as long as _select_atoms() is not _select_atoms_from_graph():
+        before the graph is complete, dep_check() selects packages with
+        _select_pkg_highest_available(), which records what it selected
+        (_highest_pkg_cache, _visible_pkgs), so the probe is not skipped
+        then. With the graph's own trees it only reads the graph.
+
+        Within one _slot_operator_trigger_reinstalls loop the result of
+        _select_atoms_probe() for a package does not change (_probe_memo
+        relies on that), so it does not matter that the probe may now be
+        computed at a later request than before, or not at all.
+        """
+        pkgsettings = self._frozen_config.pkgsettings[root]
+        if (
+            getattr(self._select_atoms, "__func__", None)
+            is not depgraph._select_atoms_from_graph
+            or not pkgsettings.local_config
+            or (
+                pkg.built
+                and self._dynamic_config.myparams.get(
+                    "ignore_built_slot_operator_deps", "n"
+                )
+                == "y"
+            )
+            or self._dynamic_config._graph_trees[root].get("virt_parent") is not None
+            or not self._probe_bounds_allowed()
+        ):
+            return frozenset()
+        use = self._pkg_use_enabled(pkg)
+        cache_key = (root, pkg, use)
+        certain = self._frozen_config._probe_certain_cache.get(cache_key)
+        if certain is not None:
+            return certain
+        # The same use_reduce() call that _select_atoms_highest_available()
+        # makes for a dependency string of the parent pkg.
+        eapi = pkg.eapi
+        is_valid_flag = None
+        if not pkg.installed:
+            is_valid_flag = pkg.iuse.is_valid_flag
+        pprovideddict = pkgsettings.pprovideddict
+        certain = set()
+        try:
+            for k in pkg._dep_keys:
+                v = pkg._metadata.get(k)
+                if not v:
+                    continue
+                for atom in portage.dep.use_reduce(
+                    v,
+                    uselist=use,
+                    opconvert=True,
+                    token_class=Atom,
+                    is_valid_flag=is_valid_flag,
+                    eapi=eapi,
+                ):
+                    if atom.__class__ is Atom:
+                        cp = atom.cp
+                        if not cp.startswith("virtual/") and cp not in pprovideddict:
+                            certain.add(atom.unevaluated_atom)
+        except InvalidDependString:
+            certain = set()
+        certain = self._frozen_config._probe_certain_cache[cache_key] = frozenset(
+            certain
+        )
+        return certain
+
     def _select_atoms_probe_imp(self, root, pkg):
         selected_atoms = []
         use = self._pkg_use_enabled(pkg)
