+def _pretend_shortcuts_wanted(action, opts):
+    """
+    True if this process is the emerge program itself (not some other program
+    that calls emerge_main() as a library function) and it was asked to
+    --pretend a merge (no other action). Such a process only computes a
+    merge list and prints it: nothing is built or merged, and it ends as
+    soon as emerge_main() has returned. That allows two shortcuts which do
+    not change anything it prints, see _pretend_disable_gc() and
+    _pretend_arm_fast_exit().
+    """
+    if action is not None or "--pretend" not in opts:
+        return False
+    main_module = sys.modules.get("__main__")
+    main_file = getattr(main_module, "__file__", None)
+    return (
+        getattr(portage, "_internal_caller", False) is True
+        and isinstance(main_file, str)
+        and os.path.basename(main_file) == "emerge"
+        and getattr(main_module, "emerge_main", None) is emerge_main
+    )
+
+
+def _pretend_disable_gc():
+    """
+    Keep the cyclic garbage collector switched off for the rest of this
+    --pretend process. The resolver builds millions of long-lived container
+    objects, so every collection walks a large heap to free comparatively
+    little, and the process ends right after the result is printed.
+    Reference counting still frees everything that is not part of a
+    reference cycle. This only changes when the memory of unreachable cycles
+    is returned, not what is computed. To bound the memory held by such
+    cycles (mostly the depgraph of each failed backtracking attempt),
+    _backtrack_depgraph() collects once whenever _pretend_gc_limit net
+    container allocations have piled up since the last collection.
+    """
+    from _emerge import depgraph
+
+    if gc.isenabled():
+        gc.disable()
+        depgraph._pretend_gc_limit = depgraph._PRETEND_GC_LIMIT
+
+
+# Set while the interpreter runs the exit hook below.
+_pretend_fast_exit_running = False
+
+
+def _pretend_arm_fast_exit(retval):
+    """
+    Called when run_action() has returned retval in a --pretend run of the
+    emerge program: all that is left to do is to end the process with that
+    status. A normal interpreter shutdown first walks and frees the whole
+    heap (package cache, dependency graphs), which takes about a second and
+    has no visible effect. The hook registered here runs when the interpreter
+    starts to shut down, i.e. after the emerge script has called
+    sys.exit(retval) and has closed its event loop. It runs the exit hooks
+    registered by everybody else, flushes stdout and stderr, and ends the
+    process with the status that sys.exit(retval) gives, without the heap
+    teardown.
+
+    It stands back, and the normal shutdown goes on, if retval is not a
+    plain status, if an exception was reported after emerge_main() returned
+    (then the status is not retval), or if flushing fails.
+    """
+    if retval is None:
+        status = 0
+    elif type(retval) is int and 0 <= retval <= 255:
+        status = retval
+    else:
+        return
+
+    def fast_exit():
+        global _pretend_fast_exit_running
+        if _pretend_fast_exit_running:
+            # Called again by atexit._run_exitfuncs() below.
+            return
+        if (
+            getattr(sys, "last_exc", None) is not None
+            or getattr(sys, "last_value", None) is not None
+        ):
+            return
+        _pretend_fast_exit_running = True
+        try:
+            # The other exit hooks, in their usual order (this one was
+            # registered last, so it is the first one to be called).
+            atexit._run_exitfuncs()
+            sys.stdout.flush()
+            sys.stderr.flush()
+        except BaseException:
+            return
+        os._exit(status)
+
+    atexit.register(fast_exit)
+
+
