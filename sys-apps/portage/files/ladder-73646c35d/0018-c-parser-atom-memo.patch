+def _c_opconvert(seq):
+    """
+    Convert the non-flat form of a use_reduce() result (an any-of group is
+    the string "||" followed by the list of its alternatives) to the
+    opconvert form (the group is one list that starts with "||").
+    """
+    out = []
+    i = 0
+    n = len(seq)
+    while i < n:
+        item = seq[i]
+        if item.__class__ is str:
+            i += 1
+            group = [item]
+            for alt in seq[i]:
+                group.append(_c_opconvert(alt) if alt.__class__ is list else alt)
+            out.append(group)
+        elif item.__class__ is list:
+            out.append(_c_opconvert(item))
+        else:
+            out.append(item)
+        i += 1
+    return out
+
