+def _use_reduce_c_validated(
+    depstr,
+    uselist,
+    masklist,
+    matchall,
+    excludeall,
+    is_src_uri,
+    eapi,
+    opconvert,
+    flat,
+    is_valid_flag,
+    token_class,
+    matchnone,
+    subset,
+):
+    """
+    use_reduce() leaves every call that has an is_valid_flag callable to the
+    Python parser, since the C parser knows nothing about IUSE. This covers
+    the calls of that kind which the resolver makes for the dependency
+    strings of every ebuild, with Atom tokens and an EAPI that the C
+    grammar covers: the one of Package._validate_deps() (all conditionals
+    active, flat), and the ones that evaluate the conditionals with the USE
+    of the package (flat, nested, or nested with opconvert).
+
+    The Python parser consults is_valid_flag in two places only: for the
+    flag of every "flag?" conditional (when the group is closed, whether or
+    not it is active), and (Atom._validate_conditional_flags) for the flags
+    of the USE conditionals inside every atom (every token is made an Atom,
+    whether or not its group is active). Everything else that can make it
+    raise depends on the string and the EAPI alone. So if the C parser
+    accepts the string and all of these flags are valid
+    (_use_reduce_c_matchall), the Python parser accepts it in every one of
+    these modes, and the result is what the C parser gives for the same
+    mode, like in the calls without is_valid_flag that use_reduce() hands to
+    the C parser itself; the opconvert form is derived from the nested one
+    (_c_opconvert). The tokens are the same interned Atom instances. In
+    every other case None is returned and the Python parser runs like
+    before, so it alone decides about errors and their messages. This runs
+    behind the LRU cache of _use_reduce_cached, hence the cache sees the
+    same keys in the same order as before.
+    """
+    if (
+        _c_dep_parser is None
+        or token_class is not Atom
+        or is_valid_flag is None
+        or is_src_uri
+        or subset is not None
+        or matchnone
+        or masklist
+        or excludeall
+        or eapi is None
+        or not _get_eapi_attrs(eapi).slot_operator
+    ):
+        return None
+    if matchall:
+        if opconvert or not flat:
+            return None
+        result = _use_reduce_c_matchall(depstr, eapi, is_valid_flag)
+        _use_reduce_c_valid[(depstr, eapi, is_valid_flag)] = result is not None
+        return result
+    if flat and opconvert:
+        return None
+    valid_key = (depstr, eapi, is_valid_flag)
+    valid = _use_reduce_c_valid.get(valid_key)
+    if valid is None:
+        valid = _use_reduce_c_valid[valid_key] = (
+            _use_reduce_c_matchall(depstr, eapi, is_valid_flag) is not None
+        )
+    if not valid:
+        return None
+    try:
+        result = _c_fast_use_reduce(depstr, uselist, False, eapi, flat)
+    except Exception:
+        return None
+    if opconvert:
+        result = _c_opconvert(result)
+    return result
+
