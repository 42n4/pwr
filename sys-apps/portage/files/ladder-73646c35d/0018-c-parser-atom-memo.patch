+# (depstr, eapi) -> None if _use_reduce_c_matchall() cannot serve the string
+# whatever the IUSE, else (tokens, flags): the tuple of all tokens and the
+# tuple of the distinct flags that is_valid_flag has to accept.
+_use_reduce_c_matchall_memo = {}
+
