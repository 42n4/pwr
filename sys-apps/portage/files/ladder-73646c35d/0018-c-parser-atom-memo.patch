+def _use_reduce_c_matchall(depstr, eapi, is_valid_flag):
+    """
+    The flat list of all tokens of depstr (all conditionals active) from the
+    C parser, if it accepts the string and is_valid_flag accepts the flag of
+    every "flag?" conditional and of every USE conditional inside an atom.
+    None otherwise.
+
+    The parse does not depend on is_valid_flag, so the tokens and the flags
+    to check are remembered per (depstr, eapi): different versions of a
+    package mostly share their dependency strings. is_valid_flag is the
+    side-effect-free IUSE test of a package, so asking it once per distinct
+    flag, in any order, gives the same verdict as asking for every
+    occurrence. The tokens are immutable interned Atoms (or "||"); each
+    call returns a new list of them.
+    """
+    key = (depstr, eapi)
+    try:
+        memo = _use_reduce_c_matchall_memo[key]
+    except KeyError:
+        memo = _use_reduce_c_matchall_memo[key] = _use_reduce_c_matchall_parse(
+            depstr, eapi
+        )
+    if memo is None:
+        return None
+    for flag in memo[1]:
+        if not is_valid_flag(flag):
+            return None
+    return list(memo[0])
+
+
+def _use_reduce_c_matchall_parse(depstr, eapi):
+    try:
+        result = _c_fast_use_reduce(depstr, frozenset(), True, eapi, True)
+    except Exception:
+        return None
+    flags = {}
+    for token in depstr.split():
+        if token[-1] == "?":
+            if token[:1] == "!":
+                flags[token[1:-1]] = None
+            else:
+                flags[token[:-1]] = None
+    for token in result:
+        if token.__class__ is Atom:
+            use = token._use
+            if use is not None and use.conditional:
+                for cond_flags in use.conditional.values():
+                    for flag in cond_flags:
+                        flags[flag] = None
+        elif token != "||":
+            # Not a token that the comparison with the Python parser
+            # was made for.
+            return None
+    return (tuple(result), tuple(flags))
+
+
