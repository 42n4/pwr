 class DepPriority(AbstractDepPriority):
     __slots__ = ("cross", "ignored", "optional", "satisfied")
 
+    def copy(self):
+        # What AbstractDepPriority.copy() does for an instance of exactly
+        # this class with all ten slots set (they are, after __init__ or
+        # copy): a new instance with the same slot values. If a slot is not
+        # set, the attribute error sends it to the generic code, which
+        # copies the slots that are set. The resolver copies a priority for
+        # every dependency it adds.
+        if self.__class__ is not DepPriority:
+            return AbstractDepPriority.copy(self)
+        result = DepPriority.__new__(DepPriority)
+        try:
+            result.buildtime = self.buildtime
+            result.buildtime_slot_op = self.buildtime_slot_op
+            result.installtime = self.installtime
+            result.runtime = self.runtime
+            result.runtime_post = self.runtime_post
+            result.runtime_slot_op = self.runtime_slot_op
+            result.cross = self.cross
+            result.ignored = self.ignored
+            result.optional = self.optional
+            result.satisfied = self.satisfied
+        except AttributeError:
+            return AbstractDepPriority.copy(self)
+        return result
+
