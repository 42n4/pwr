@@ -35,4 +36,45 @@
         return self.__int__() >= other
 
     def copy(self):
-        return copy.copy(self)
+        # What copy.copy() does for an instance of a class that has only
+        # slots and no hooks of its own for copying or pickling: a new
+        # object from cls.__new__(cls), then setattr() for every slot that
+        # is set, the slot names coming from copyreg._slotnames(). Doing it
+        # here skips the detour through __reduce_ex__(), which is slow, and
+        # priorities are copied for every dependency. Any other class goes
+        # through copy.copy() as before.
+        cls = self.__class__
+        slot_names = _copy_slot_names.get(cls)
+        if slot_names is None:
+            slot_names = _copy_slot_names[cls] = _get_copy_slot_names(cls)
+        if slot_names is False:
+            return copy.copy(self)
+        result = cls.__new__(cls)
+        for name in slot_names:
+            try:
+                value = getattr(self, name)
+            except AttributeError:
+                continue
+            setattr(result, name, value)
+        return result
+
+
+# class -> tuple of slot names for AbstractDepPriority.copy(), or False if
+# the class has to be copied by copy.copy().
+_copy_slot_names = {}
+
+
+def _get_copy_slot_names(cls):
+    if (
+        cls.__dictoffset__ != 0
+        or getattr(cls, "__copy__", None) is not None
+        or cls in copyreg.dispatch_table
+        or cls.__reduce_ex__ is not object.__reduce_ex__
+        or cls.__reduce__ is not object.__reduce__
+        or cls.__getstate__ is not object.__getstate__
+        or hasattr(cls, "__setstate__")
+        or hasattr(cls, "__getnewargs__")
+        or hasattr(cls, "__getnewargs_ex__")
+    ):
+        return False
+    return tuple(copyreg._slotnames(cls))
