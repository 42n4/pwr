+def _regenerate_use_stack(use_stack_inputs, iuse):
+    """
+    The USE stacking loop of config.regenerate(), moved here unchanged except
+    that it works on the values that regenerate() has read from the dbs of
+    uvlist (in the same order, with the same lookups) instead of reading them
+    itself. use_stack_inputs has one item per db:
