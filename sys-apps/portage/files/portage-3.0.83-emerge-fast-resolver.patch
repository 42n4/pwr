+                                    "operator in non-incremental variable "
+                                    "'%s': '%s'\n"
+                                )
+                                % (var, x),
+                            ),
+                            noiselevel=-1,
+                        )
+                        continue
+                    else:
+                        writemsg(
+                            colorize(
+                                "BAD",
+                                _(
+                                    "Invalid '+' "
+                                    "operator in incremental variable "
+                                    "'%s': '%s'\n"
+                                )
+                                % (var, x),
+                            ),
+                            noiselevel=-1,
+                        )
