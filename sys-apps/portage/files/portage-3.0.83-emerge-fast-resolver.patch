+class _ReplayIter:
+    """
+    Iterable over the items of the generator that factory() returns. The
+    generator is advanced lazily, exactly as far as the furthest consumer
+    went, and the items it yielded are kept, so that the next consumer gets
+    the same items without running the generator again.
+    """
+
+    __slots__ = ("_factory", "_items", "_source", "_running", "_broken")
+
+    def __init__(self, factory):
+        self._factory = factory
+        self._items = []
+        self._source = factory()
+        self._running = False
+        self._broken = False
+
+    def __iter__(self):
+        items = self._items
+        i = 0
+        while True:
+            if i < len(items):
+                yield items[i]
+                i += 1
+                continue
+            source = self._source
+            if source is None:
+                return
+            if self._running or self._broken:
+                # The shared generator is being advanced further up the
+                # stack, or it raised. Iterate a private one instead, which
+                # is what happens without the memo.
+                yield from islice(self._factory(), i, None)
+                return
+            self._running = True
+            try:
+                item = next(source)
+            except StopIteration:
+                self._source = None
+                return
+            except BaseException:
+                self._broken = True
+                raise
+            finally:
+                self._running = False
+            items.append(item)
+
+
+def _atom_key(atom):
+    """
+    What stands for an atom in the key of a cache dict: the string of a
+    plain Atom, anything else as it is. Atoms compare equal, and hash, by
+    their string alone (Atom.__eq__, Atom.__hash__; an Atom equals its
+    string, too), so a key with the string in place of the Atom finds
+    exactly the same dict entries. The string is hashed and compared
+    without a Python level call, and the resolver makes these lookups
+    several hundred thousand times per run.
