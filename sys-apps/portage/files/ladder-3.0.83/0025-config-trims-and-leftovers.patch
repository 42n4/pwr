 from portage.versions import _pkg_str, cpv_getkey
 
 
+# tuple of ACCEPT_LICENSE tokens -> frozenset of the accepted licenses
+_stack_accept_license_memo = {}
+_STACK_ACCEPT_LICENSE_MEMO_MAX = 1024
+
+
+def _stack_accept_license(accept_license, licenses):
+    """
+    The loop of getMissingLicenses() that stacks the ACCEPT_LICENSE tokens
+    of a package into the set of accepted licenses. The set depends on the
+    token sequence and, only through a "*" token, on the licenses of the
+    package. Without such a token it is therefore taken from a memo keyed by
+    the tokens: the expanded ACCEPT_LICENSE has hundreds of tokens and is the
+    same for all packages without a package.license entry. The caller only
+    tests membership, so sharing one frozenset is fine.
+    """
+    key = tuple(accept_license)
+    acceptable_licenses = _stack_accept_license_memo.get(key)
+    if acceptable_licenses is not None:
+        return acceptable_licenses
+    acceptable_licenses = set()
+    uses_licenses = False
+    for x in accept_license:
+        if x == "*":
+            uses_licenses = True
+            acceptable_licenses.update(licenses)
+        elif x == "-*":
+            acceptable_licenses.clear()
+        elif x[:1] == "-":
+            acceptable_licenses.discard(x[1:])
+        else:
+            acceptable_licenses.add(x)
+    if (
+        not uses_licenses
+        and len(_stack_accept_license_memo) < _STACK_ACCEPT_LICENSE_MEMO_MAX
+    ):
+        acceptable_licenses = frozenset(acceptable_licenses)
+        _stack_accept_license_memo[key] = acceptable_licenses
+    return acceptable_licenses
+
+
