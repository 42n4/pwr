 # Distributed under the terms of the GNU General Public License v2
 
 
+from types import MemberDescriptorType
+
+# class -> tuple of its slot names in the order in which __init__ visits
+# them, or False if the class needs the general code of __init__.
+_plain_slots = {}
+
+
+def _find_plain_slots(cls):
+    """
+    Return the slot names that SlotObject.__init__ visits for an instance of
+    cls, in its order, if every one of them is an ordinary slot: named once
+    in the __slots__ of cls and its bases, and found on cls as the slot
+    descriptor itself (no property or class attribute in front of it).
+    Return False otherwise.
+    """
+    names = []
+    classes = [cls]
+    while classes:
+        c = classes.pop()
+        if c is SlotObject:
+            continue
+        classes.extend(c.__bases__)
+        slots = getattr(c, "__slots__", None)
+        if not slots:
+            continue
+        if type(slots) not in (tuple, list):
+            return False
+        names.extend(slots)
+    if len(set(names)) != len(names):
+        return False
+    for myattr in names:
+        if type(myattr) is not str:
+            return False
+        for c in cls.__mro__:
+            if myattr in c.__dict__:
+                if type(c.__dict__[myattr]) is not MemberDescriptorType:
+                    return False
+                break
+        else:
+            return False
+    return tuple(names)
+
+
 class SlotObject:
     __slots__ = ("__weakref__",)
 
     def __init__(self, **kwargs):
+        # Fast path for classes with ordinary slots only (see
+        # _find_plain_slots). For such a slot of a new instance, the test
+        # "getattr(self, myattr, None) is not None" below is false (the slot
+        # is empty) and setattr() cannot fail, so all that the loop below
+        # does is setattr(self, myattr, kwargs.pop(myattr, None)) in the
+        # same order. The only difference: a slot that was given a value
+        # other than None before this constructor ran, and that is not in
+        # kwargs, is set to None here where the loop below raises
+        # AssertionError.
+        cls = self.__class__
+        plain_slots = _plain_slots.get(cls)
+        if plain_slots is None:
+            plain_slots = _plain_slots[cls] = _find_plain_slots(cls)
+        if plain_slots is not False:
+            if kwargs:
+                pop = kwargs.pop
+                for myattr in plain_slots:
+                    setattr(self, myattr, pop(myattr, None))
+                if kwargs:
+                    raise TypeError(
+                        "'%s' is an invalid keyword argument for this constructor"
+                        % (next(iter(kwargs)),)
+                    )
+            else:
+                for myattr in plain_slots:
+                    setattr(self, myattr, None)
+            return
+
         classes = [self.__class__]
         while classes:
             c = classes.pop()
