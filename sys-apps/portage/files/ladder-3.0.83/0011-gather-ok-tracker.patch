+class _GatherOkTracker:
+    """Incrementally maintained set of the nodes for which gather_deps (see
+    depgraph._serialize_tasks) succeeds under one ignore_priority filter.
+
+    It yields exactly the ok_nodes set that
+    depgraph._gather_deps_closures(graph, valid, ignore_priority) computes
+    from scratch: the nodes of `valid` from which every node reachable over
+    child edges surviving `ignore_priority` is in `valid` too. Equivalently,
+    the largest subset of `valid` that is closed under those child edges.
+
+    Why it can be maintained instead of recomputed: as long as the graph only
+    loses nodes (hence edges) and `valid` only loses nodes that left the
+    graph, an ok node stays ok until it is removed, and a not-ok ("bad") node
+    stays bad as long as one particular proof of its badness survives. The
+    proof kept for each bad member of `valid` is a witness: one surviving child
+    that is itself bad. Witness chains end at a node outside `valid` (a "root",
+    bad by definition) and never loop, because a witness is only ever assigned
+    when it already has a complete chain. So only nodes whose chain was cut
+    (by a removal, or because its root became valid) have to be re-examined.
+
+    Whenever the monotonicity premise does not hold (an edge or node was added,
+    or a node left `valid` while staying in the graph) everything is rebuilt
+    from scratch, which is the same procedure applied to all of `valid`.
+    """
+
+    def __init__(self, graph, frontier, ignore_priority):
+        self._graph = graph
+        self._frontier = frontier
+        self._ignore_priority = ignore_priority
+        self._ok = set()
+        # bad member of valid -> its witness (a bad child)
+        self._wit = {}
+        # bad node -> set of the nodes that use it as their witness
+        self._deps = {}
+        self._prev_valid = None
+        self._log_pos = 0
+        self._add_count = 0
+
+    def sync(self, valid):
+        """Bring the state up to date with the graph and with `valid` (a set
+        the caller will not mutate) and return the set of ok nodes. The
+        returned set is owned by the tracker; do not mutate it."""
+        graph = self._graph
+        graph_nodes = graph.nodes
+        frontier = self._frontier
+        removed_log = frontier.removed_log
+        ok = self._ok
+        wit = self._wit
+        deps = self._deps
+        prev_valid = self._prev_valid
+
+        rebuild = prev_valid is None or frontier.add_count != self._add_count
+        if not rebuild:
+            for node in prev_valid - valid:
+                if node in graph_nodes:
+                    # Left valid without leaving the graph: not monotone.
+                    rebuild = True
+                    break
+
+        if rebuild:
+            ok.clear()
+            wit.clear()
+            deps.clear()
+            unsettled = set(valid)
+        else:
+            # Collect the nodes whose proof of badness is gone: those whose
+            # witness was removed, and former roots that became valid.
+            pending = []
+            for i in range(self._log_pos, len(removed_log)):
+                node = removed_log[i]
+                ok.discard(node)
+                witness = wit.pop(node, None)
+                if witness is not None:
+                    users = deps.get(witness)
+                    if users is not None:
+                        users.discard(node)
+                users = deps.pop(node, None)
+                if users:
+                    pending.extend(users)
+            pending.extend(valid - prev_valid)
+            # ... together with everything whose witness chain passes through
+            # one of them.
+            unsettled = set()
+            while pending:
+                node = pending.pop()
+                if node in unsettled or node not in graph_nodes:
+                    continue
+                unsettled.add(node)
+                witness = wit.pop(node, None)
+                if witness is not None:
+                    users = deps.get(witness)
+                    if users is not None:
+                        users.discard(node)
+                users = deps.pop(node, None)
+                if users:
+                    pending.extend(users)
+
+        self._prev_valid = valid
+        self._log_pos = len(removed_log)
+        self._add_count = frontier.add_count
+
+        if unsettled:
+            # Every graph node is now exactly one of: ok, settled bad (outside
+            # valid, or holding a witness), or unsettled. An unsettled node is
+            # bad iff it has a surviving child that is settled bad, or one that
+            # is unsettled and turns out bad.
+            ignore_priority = self._ignore_priority
+            queue = deque()
+            for node in unsettled:
+                for child in graph.child_nodes_iter(
+                    node, ignore_priority=ignore_priority
+                ):
+                    if child not in unsettled and child not in ok:
+                        wit[node] = child
+                        users = deps.get(child)
+                        if users is None:
+                            deps[child] = users = set()
+                        users.add(node)
+                        queue.append(node)
+                        break
+            unsettled.difference_update(queue)
+            while queue:
+                node = queue.popleft()
+                for parent in graph.parent_nodes(
+                    node, ignore_priority=ignore_priority
+                ):
+                    if parent in unsettled:
+                        unsettled.discard(parent)
+                        wit[parent] = node
+                        users = deps.get(node)
+                        if users is None:
+                            deps[node] = users = set()
+                        users.add(parent)
+                        queue.append(parent)
+            # What is left is closed under surviving child edges and inside
+            # valid, hence ok.
+            ok.update(unsettled)
+
+        return ok
+
+
