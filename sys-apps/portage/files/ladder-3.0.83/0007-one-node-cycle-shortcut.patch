+    def leaves_among(self, nodes, level):
+        """Return the members of `nodes` that are leaves under `level`, in the
+        iteration order of `nodes`. Same test as is_leaf()."""
+        surv_get = self._surv.get
+        result = []
+        for node in nodes:
+            counts = surv_get(node)
+            if counts is not None and counts[level] == 0:
+                result.append(node)
+        return result
