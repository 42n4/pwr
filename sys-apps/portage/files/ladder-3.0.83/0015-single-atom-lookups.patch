+def _find_single_atom(atom, pkg, modified_use=None):
+    """
+    For an atom that is an instance of exactly Atom without extended
+    (wildcard) syntax, return what
+
+        InternalPackageSet(initial_atoms=(atom,), allow_repo=True)
+            .findAtomForPackage(pkg, modified_use=modified_use)
+
+    returns, without building the set. Such a set accepts the atom as it is
+    and files it under its cp, and findAtomForPackage() then does this:
+    it replaces pkg by a copy with the modified USE if that is not the USE
+    of pkg; it returns None if the set has nothing for the cp of pkg, i.e.
+    if that is not the cp of the atom; and for a set with this one atom it
+    returns the atom if match_from_list() matches it with pkg, else None
+    (see the single atom shortcut in PackageSet.findAtomForPackage). The
+    resolver asks this question for every parent atom of every package it
+    probes.
+    """
+    if modified_use is not None and modified_use is not pkg.use.enabled:
+        pkg = pkg.copy()
+        pkg._metadata["USE"] = " ".join(modified_use)
+    atom_cp = atom.cp
+    if atom_cp != portage.cpv_getkey(pkg.cpv):
+        return None
+    if atom_cp != pkg.cp:
+        # Not expected (the cp of a package is that of its cpv): the
+        # general code decides.
+        return InternalPackageSet(
+            initial_atoms=(atom,), allow_repo=True
+        ).findAtomForPackage(pkg)
+    if match_from_list(atom, [pkg]):
+        return atom
+    return None
+
