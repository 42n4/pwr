+    def get(self, cp, default=None):
+        # Upstream commit 98f5b2293 (after 3.0.83), unchanged. The inherited
+        # Mapping.get() returns default when __getitem__ raises KeyError.
+        # Without extended keys, __getitem__ raises KeyError for a str that
+        # is not a normal key: for one with "*" from the empty _extended,
+        # for any other because neither _normal nor _extended matches. Most
+        # lookups are such misses; answer them without raising and catching.
+        if not self._extended and isinstance(cp, str) and cp not in self._normal:
+            return default
+        try:
+            return self[cp]
+        except KeyError:
+            return default
