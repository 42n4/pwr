+    def _select_atoms_flat(self, depstring, pkgsettings, mytrees, parent):
+        """
+        The result of _select_atoms_highest_available() for a dependency
+        list in which dep_check() has nothing to choose, or None if the list
+        is not of that kind: a non-empty list of Atom instances only (no
+        "||" group, hence no nested list either), none of them for a
+        virtual/ package or for a package that package.provided names, with
+        local_config set and no virt_parent in mytrees.
+
+        For such a list dep_check() does the following, step by step, and
+        calls nothing that looks at the graph, the databases or the state
+        that _select_atoms_highest_available() sets up around the call:
+        _expand_new_virtuals() copies the list, and adds (atom, id(atom)) as
+        a child of parent to atom_graph for every atom, if there is a
+        parent; _overlap_dnf() returns it unchanged, since it contains no
+        disjunction; dep_wordreduce(), without a dbapi and with none of
+        the packages in package.provided, marks every atom as not satisfied; and
+        dep_zapdeps() then returns every atom, in order, in a new list.
+        Without a parent that list is the result. With a parent the result
+        is an OrderedDict with the one key parent, whose value lists the
+        atom of every child node of parent in atom_graph: every atom once
+        per object (the node of an atom object that occurs twice is the same
+        node), in the order of the first occurrences.
+        """
+        if (
+            not depstring
+            or not pkgsettings.local_config
+            or mytrees.get("virt_parent") is not None
+        ):
+            return None
+        pprovideddict = pkgsettings.pprovideddict
+        for atom in depstring:
+            if atom.__class__ is not Atom:
+                return None
+            cp = atom.cp
+            if cp.startswith("virtual/") or cp in pprovideddict:
+                return None
+        if parent is None:
+            return depstring[:]
+        child_atoms = []
+        seen = set()
+        for atom in depstring:
+            atom_id = id(atom)
+            if atom_id not in seen:
+                seen.add(atom_id)
+                child_atoms.append(atom)
+        selected_atoms = OrderedDict()
+        selected_atoms[parent] = child_atoms
+        return selected_atoms
+
     def _expand_virt_from_graph(self, root, atom):
         if not isinstance(atom, Atom):
             atom = Atom(atom)
