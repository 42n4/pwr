--- a/lib/portage/dep/__init__.py
+++ b/lib/portage/dep/__init__.py
@@ -606,8 +606,39 @@
     return " ".join(mystrparts)
 
 
+def _copy_dep_lists(dep_struct):
+    """
+    Return a copy of a use_reduce result in which every (nested) list is a
+    new list, holding the very same tokens.
+    """
+    return [_copy_dep_lists(x) if x.__class__ is list else x for x in dep_struct]
+
+
+# Results of _use_reduce_parse by argument tuple. The values are private
+# copies that are never handed out, so that nobody can modify them.
+_use_reduce_parsed = {}
+
+
 @lru_cache(1024)
-def _use_reduce_cached(
+def _use_reduce_cached(*args):
+    """
+    The LRU cache in front of this function is unchanged, so that the calls
+    for which use_reduce returns a result that shares its nested lists with
+    an earlier result are the same ones as before. The only difference is on
+    an LRU miss for arguments that were parsed before: instead of parsing the
+    string again, the lists of the earlier result are copied. Exceptions are
+    not recorded, they are raised by parsing again like before.
+    """
+    try:
+        parsed = _use_reduce_parsed[args]
+    except KeyError:
+        result = _use_reduce_parse(*args)
+        _use_reduce_parsed[args] = _copy_dep_lists(result)
+        return result
+    return _copy_dep_lists(parsed)
+
+
