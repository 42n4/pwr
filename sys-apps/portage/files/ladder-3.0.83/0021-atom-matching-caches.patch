+def _match_kind_init(mydep):
+    """
+    Classify an Atom for _match_single() and remember the class in the
+    atom: 1 if match_from_list() takes its "operator is None" branch for
+    it, 2 to 5 for the operators > >= < <=, and 0 if _match_single() is
+    not to be used (blockers, wildcard atoms, atoms with a repository, the
+    operators = =* ~, and the atoms for which match_from_list() raises or
+    prints a message). These are the statements of match_from_list() up to
+    its branch on the operator; they depend on nothing but the atom, which
+    is immutable.
+    """
+    kind = 0
+    if not mydep.blocker and not mydep.extended_syntax and not mydep.repo:
+        mycpv = mydep.cpv
+        mycpv_cps = catpkgsplit(mycpv)
+        if not mycpv_cps:
+            kind = 1
+        elif mydep != mycpv:
+            if mycpv_cps[2] and mycpv_cps[3]:
+                kind = _match_kinds.get(mydep.operator, 0)
+            else:
+                kind = 1
+    mydep._match_kind = kind
+    return kind
+
+
+def _match_single(mydep, x, kind):
+    """
+    Whether match_from_list(mydep, [x]) returns [x] (True) or [] (False),
+    for an Atom of a kind that _match_kind_init() accepts and a candidate
+    that has a cp attribute (a _pkg_str, a Package, an Atom); None if that
+    has to be found out by match_from_list() itself. The resolver matches
+    one atom against one package several hundred thousand times per run.
+
+    This performs, for the one candidate, the tests of match_from_list() in
+    their order: the cp ("operator is None" branch) or the cp and the
+    version comparison (> >= < <=), then the slot, then USE, and nothing
+    else, since the atom has no repository. Only attributes are read that
+    match_from_list() reads at the same point for a candidate that got as
+    far (in particular the "use" attribute, which a Package computes
+    lazily). The USE dependencies themselves are left to
+    match_from_list(), as is everything unusual.
+    """
+    try:
+        cp = x.cp
+    except AttributeError:
+        return None
+    if cp != mydep._cp:
+        return False
+    if kind != 1:
+        try:
+            result = vercmp(x.version, mydep._version)
+        except ValueError:
+            return None
+        if result is None:
+            return False
+        if kind == 2:
+            if not result > 0:
+                return False
+        elif kind == 3:
+            if not result >= 0:
+                return False
+        elif kind == 4:
+            if not result < 0:
+                return False
+        elif not result <= 0:
+            return False
+    if mydep._slot is not None:
+        try:
+            x.cpv
+        except AttributeError:
+            return None
+        try:
+            x.slot
+        except AttributeError:
+            pass
+        else:
+            if not _match_slot(mydep, x):
+                return False
+    if mydep._unevaluated_atom._use and hasattr(x, "use"):
+        return None
+    return True
+
