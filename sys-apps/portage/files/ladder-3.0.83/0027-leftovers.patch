--- a/lib/_emerge/Package.py
+++ b/lib/_emerge/Package.py
@@ -854,6 +854,13 @@
     def __len__(self):
         return 4
 
+    # The truth value of a Package is asked all the time ("if pkg:"). Without
+    # __bool__ it is taken from __len__ above, a call of a Python function
+    # that always returns 4, so it is always True. (1).__bool__ is a builtin
+    # that returns True; the interpreter calls a __bool__ that is not a
+    # function without arguments, and no Python frame is needed.
+    __bool__ = (1).__bool__
+
     def __iter__(self):
         """
         This is used to generate mtimedb resume mergelist entries, so we
@@ -922,6 +929,13 @@
 
 _PackageMetadataWrapperBase = slot_dict_class(_all_metadata_keys)
 
+# (slot name, key) for every key of the class above, in the order in which
+# its iteritems() looks at them. See _PackageMetadataWrapper.__init__.
+_metadata_slots = tuple(
+    (_PackageMetadataWrapperBase._prefix + k, k)
+    for k in _PackageMetadataWrapperBase.allowed_keys
+)
+
 
 class _PackageMetadataWrapper(_PackageMetadataWrapperBase):
     """
@@ -945,7 +959,24 @@
             # USE is lazy, but we want it to show up in self.keys().
             _PackageMetadataWrapperBase.__setitem__(self, "USE", "")
 
-        self.update(metadata)
+        if metadata.__class__ is _PackageMetadataWrapperBase:
+            # What self.update(metadata) does for this class, without a
+            # generator and two method calls per key: iteritems() yields
+            # the keys of allowed_keys that are set, in the iteration
+            # order of that frozenset (_metadata_slots was made from the
+            # same object), and __setitem__ stores each value in its slot
+            # and then calls the _set_* hook of a wrapped key.
+            wrapped_keys = self._wrapped_keys
+            for attr, k in _metadata_slots:
+                try:
+                    v = getattr(metadata, attr)
+                except AttributeError:
+                    continue
+                setattr(self, attr, v)
+                if k in wrapped_keys:
+                    getattr(self, "_set_" + k.lower())(k, v)
+        else:
+            self.update(metadata)
 
     def __getitem__(self, k):
         v = _PackageMetadataWrapperBase.__getitem__(self, k)
