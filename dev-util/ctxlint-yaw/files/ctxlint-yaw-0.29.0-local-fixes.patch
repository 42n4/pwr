+/**
+ * LOCAL F3: a reference with no anchor (`./`, `../`, `/`) that is missing where the linter resolves it, but exists
+ * deeper in the project under the same relative spelling, was written relative to another directory (a doc section
+ * that says "cd there first", a sub-tree described from its own root). That is worth a note, not an error.
+ * Single-segment directory names qualify only when distinctive (a digit, `_` or `-`): `build/` exists everywhere.
+ */
+function foundElsewhere(refValue: string, projectFiles: string[]): string | null {
+  if (/^\.{0,2}\//.test(refValue) || refValue.startsWith('~') || refValue.startsWith('@')) return null;
+  const isDir = refValue.endsWith('/');
+  const ref = refValue.replace(/\/+$/, '');
+  if (ref.length < 4) return null;
+  if (!ref.includes('/') && !(isDir && /[\d_-]/.test(ref))) return null;
+  let best: string | null = null;
+  for (const raw of projectFiles) {
+    const f = raw.replace(/\\/g, '/');
+    let hit: string | null = null;
+    const at = `/${f}`.indexOf(`/${ref}/`);
+    if (at >= 0) hit = `/${f}`.slice(1, at + 1 + ref.length);
+    else if (!isDir && f.endsWith(`/${ref}`)) hit = f;
+    if (hit !== null && hit !== ref && (best === null || hit.length < best.length)) best = hit;
+  }
+  return best;
+}
